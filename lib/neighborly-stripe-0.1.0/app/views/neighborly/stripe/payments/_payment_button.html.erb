<% if project.use_stripe? && project.stripe_ready? %>
  <div class="stripe-payment-section">
    <h4 class="mb-3">Contribuer via Stripe</h4>
    
    <%= form_with url: "/stripe/projects/#{project.id}/payments", method: :post, class: "stripe-contribution-form" do |f| %>
      <div class="form-group mb-3">
        <label for="contribution_amount" class="form-label">Montant de votre contribution (€)</label>
        <div class="input-group">
          <span class="input-group-text">€</span>
          <%= number_field_tag :amount, 10, min: 1, step: 0.01, class: 'form-control form-control-lg', required: true %>
        </div>
        <small class="form-text text-muted">
          Frais de plateforme: <%= ENV.fetch('PLATFORM_FEE', '5') %>%
        </small>
      </div>
      
      <%= button_tag type: 'submit', class: 'btn btn-primary btn-lg w-100' do %>
        <i class="fas fa-credit-card me-2"></i>
        Contribuer maintenant avec Stripe
      <% end %>
      
      <div class="text-center mt-3">
        <small class="text-muted">
          <i class="fas fa-lock me-1"></i>
          Paiement sécurisé par Stripe
        </small>
      </div>
    <% end %>
  </div>
<% elsif project.user == current_user && !project.use_stripe? %>
  <div class="alert alert-info">
    <h5><i class="fas fa-info-circle me-2"></i>Activez Stripe pour recevoir des paiements</h5>
    <p class="mb-3">Stripe permet de recevoir des paiements en ligne de manière sécurisée.</p>
    
    <% if current_user.stripe_onboarding_complete? %>
      <%= button_to "Activer Stripe sur ce projet", "/projects/#{project.id}/enable_stripe", method: :post, class: "btn btn-success" %>
    <% else %>
      <p class="mb-2">Vous devez d'abord configurer votre compte Stripe:</p>
      <%= button_to "Configurer mon compte Stripe", "/stripe/connect/create", method: :post, class: "btn btn-primary" %>
    <% end %>
  </div>
<% end %>
