<div class="stripe-payment-container">
  <div class="stripe-payment-form">
    <div class="payment-info mb-3">
      <h5><%= I18n.t('stripe.payment_method.title', default: 'Paiement par carte bancaire') %></h5>
      <p class="text-muted">
        <%= I18n.t('stripe.secure_payment', default: 'Paiement sécurisé via Stripe') %>
      </p>
    </div>

    <div class="contribution-summary mb-3">
      <div class="d-flex justify-content-between align-items-center">
        <span><%= I18n.t('stripe.contribution_amount', default: 'Montant de votre contribution') %></span>
        <strong class="amount-display">
          <%= number_to_currency(@amount, unit: @project.currency_sym) %>
        </strong>
      </div>
    </div>

    <%= form_tag "/stripe/projects/#{@project.id}/payments", method: :post, class: "stripe-checkout-form", id: "stripe-payment-form" do %>
      <%= hidden_field_tag :amount, @amount %>
      <% if @contribution %>
        <%= hidden_field_tag :contribution_id, @contribution.id %>
      <% end %>
      
      <button type="submit" class="btn btn-primary btn-lg w-100 stripe-pay-button">
        <i class="fa fa-lock"></i>
        <%= I18n.t('stripe.pay_now', default: 'Payer maintenant avec Stripe') %>
      </button>
      
      <div class="text-center mt-2">
        <small class="text-muted">
          <i class="fa fa-shield"></i>
          <%= I18n.t('stripe.secure_info', default: 'Vous serez redirigé vers la page de paiement sécurisée Stripe') %>
        </small>
      </div>
    <% end %>

    <div class="stripe-cards-logos text-center mt-3">
      <img src="<%= asset_path('payments/visa.png') rescue '/assets/payments/visa.png' %>" alt="Visa" height="24" style="margin: 0 5px;">
      <img src="<%= asset_path('payments/mastercard.png') rescue '/assets/payments/mastercard.png' %>" alt="Mastercard" height="24" style="margin: 0 5px;">
    </div>
  </div>
</div>

<style>
  .stripe-payment-container {
    padding: 15px;
  }
  .stripe-payment-form {
    background: #f9f9f9;
    border-radius: 8px;
    padding: 20px;
  }
  .stripe-pay-button {
    background: #635bff;
    border-color: #635bff;
  }
  .stripe-pay-button:hover {
    background: #5469d4;
    border-color: #5469d4;
  }
  .amount-display {
    font-size: 1.2em;
    color: #635bff;
  }
</style>
