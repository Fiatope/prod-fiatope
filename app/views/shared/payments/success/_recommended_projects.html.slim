section.recommended-projects
  .row
    .large-12.columns.text-center.recommended
      h3 D'autres projets pourraient vous intéresser
      = link_to 'Découvrir d\'autres projets', discover_path, class: 'btn btn-medium-yellow-border'
    /- user.recommended_projects.limit(4).each do |project|
      = render partial: 'projects/project', locals: {project: project }
