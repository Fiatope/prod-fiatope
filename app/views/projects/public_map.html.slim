- content_for :title, 'Carte des projets accomplis'

- total_projects = @map_projects.size
- treated_count = @map_projects.count { |project| project[:state] == 'paid' }
- processing_count = @map_projects.count { |project| %w[request_funds waiting_funds].include?(project[:state]) }

.public-map-page
  .container
    .public-map-hero
      .public-map-hero__text
        h1 Carte publique des projets accomplis
        p
          | Explorez les projets Fiatope deja accomplis ou en cours de traitement. Cliquez sur un marqueur pour voir un resume et ouvrir la page complete du projet.
      .public-map-hero__stats
        .public-map-pill
          span.public-map-pill__value = total_projects
          span.public-map-pill__label Projets geolocalises
        .public-map-pill
          span.public-map-pill__value = treated_count
          span.public-map-pill__label Projets traites
        .public-map-pill
          span.public-map-pill__value = processing_count
          span.public-map-pill__label En traitement

    .row
      .col-md-8
        .public-map-board
          #publicProjectsMap.public-map-canvas
          #publicMapEmpty.alert.alert-info.public-map-empty[style="display:none;"]
            | Aucun projet geolocalise n est disponible pour le moment.

      .col-md-4
        #publicMapSelectionCard.public-map-selection
          .public-map-selection__placeholder
            i.fa.fa-map-marker
            h4 Selectionnez un projet
            p Cliquez sur un marqueur dans la carte pour afficher le resume ici.

    .public-map-legend
      span.public-map-legend__item
        i.public-map-dot.public-map-dot--done
        |  Traite
      span.public-map-legend__item
        i.public-map-dot.public-map-dot--processing
        |  En traitement
      span.public-map-legend__item
        i.public-map-dot.public-map-dot--done-light
        |  Accompli

script#publicMapData[type="application/json"]
  == @map_projects.to_json

css:
  .public-map-page {
    background: radial-gradient(circle at 10% 10%, rgba(31, 138, 86, 0.09), transparent 36%),
                radial-gradient(circle at 90% 0%, rgba(243, 154, 45, 0.08), transparent 34%),
                #f7fbf8;
    min-height: 100vh;
    padding: 26px 0 42px;
  }

  .public-map-hero {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    background: #ffffff;
    border: 1px solid #dde9e0;
    border-radius: 14px;
    box-shadow: 0 12px 25px rgba(20, 46, 34, 0.08);
    padding: 20px;
    margin-bottom: 16px;
  }

  .public-map-hero__text h1 {
    margin: 0 0 8px;
    font-size: 30px;
    line-height: 1.2;
    color: #1f5c3d;
    font-weight: 700;
  }

  .public-map-hero__text p {
    margin: 0;
    color: #4f6c5c;
    max-width: 750px;
  }

  .public-map-hero__stats {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: stretch;
  }

  .public-map-pill {
    min-width: 138px;
    background: linear-gradient(155deg, #1f8a56, #3aa56e);
    color: #ffffff;
    border-radius: 12px;
    padding: 10px 12px;
    box-shadow: 0 8px 18px rgba(24, 88, 57, 0.23);
  }

  .public-map-pill__value {
    display: block;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.1;
  }

  .public-map-pill__label {
    display: block;
    font-size: 12px;
    opacity: 0.9;
  }

  .public-map-board,
  .public-map-selection {
    background: #ffffff;
    border-radius: 14px;
    border: 1px solid #dde9e0;
    box-shadow: 0 10px 24px rgba(16, 44, 31, 0.08);
  }

  .public-map-board {
    overflow: hidden;
    min-height: 520px;
    position: relative;
  }

  .public-map-canvas {
    width: 100%;
    min-height: 520px;
  }

  .public-map-empty {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    margin: 0;
    z-index: 2;
  }

  .public-map-selection {
    padding: 16px;
    min-height: 520px;
  }

  .public-map-selection__placeholder {
    border: 1px dashed #cfded4;
    border-radius: 12px;
    min-height: 488px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    color: #607f6e;
    background: #fbfefd;
    padding: 16px;
  }

  .public-map-selection__placeholder i {
    font-size: 30px;
    color: #1f8a56;
    margin-bottom: 10px;
  }

  .public-map-card__image {
    width: 100%;
    height: 176px;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid #e7efe9;
    margin-bottom: 10px;
  }

  .public-map-card__title {
    margin: 0;
    font-size: 21px;
    font-weight: 700;
    color: #214f39;
    line-height: 1.25;
  }

  .public-map-card__headline {
    margin: 8px 0;
    font-size: 14px;
    color: #415e4f;
  }

  .public-map-card__meta {
    margin: 8px 0;
    color: #557564;
    font-size: 13px;
  }

  .public-map-card__badge {
    display: inline-block;
    background: #edf8f1;
    color: #1f8a56;
    border: 1px solid #cde7d8;
    border-radius: 999px;
    font-size: 12px;
    padding: 4px 9px;
    margin-bottom: 8px;
    margin-right: 6px;
  }

  .public-map-card__summary {
    margin: 0 0 10px;
    color: #3f5a4c;
    font-size: 14px;
    line-height: 1.45;
  }

  .public-map-card__cta {
    display: inline-block;
    text-decoration: none;
    background: linear-gradient(145deg, #1f8a56, #2d9c63);
    color: #ffffff !important;
    font-weight: 700;
    border-radius: 9px;
    padding: 10px 14px;
    box-shadow: 0 9px 16px rgba(31, 138, 86, 0.3);
  }

  .public-map-card__cta:hover {
    text-decoration: none;
    filter: brightness(1.04);
  }

  .public-map-legend {
    margin-top: 14px;
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    color: #4f6f5f;
    font-size: 13px;
  }

  .public-map-legend__item {
    display: inline-flex;
    align-items: center;
  }

  .public-map-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
    margin-right: 7px;
  }

  .public-map-dot--done {
    background: #2f9e44;
  }

  .public-map-dot--processing {
    background: #f08c00;
  }

  .public-map-dot--done-light {
    background: #2f7f8f;
  }

  .public-map-infowindow {
    max-width: 250px;
    font-family: Lato, sans-serif;
  }

  .public-map-infowindow h5 {
    margin: 0 0 6px;
    font-size: 16px;
    color: #214f39;
  }

  .public-map-infowindow p {
    margin: 0 0 6px;
    font-size: 12px;
    color: #3c594b;
    line-height: 1.4;
  }

  .public-map-infowindow a {
    color: #1f8a56;
    font-size: 12px;
    font-weight: 700;
  }

  @media (max-width: 991px) {
    .public-map-selection,
    .public-map-board,
    .public-map-canvas {
      min-height: 430px;
    }

    .public-map-selection__placeholder {
      min-height: 396px;
    }
  }

javascript:
  (function() {
    function parseMapData() {
      var source = document.getElementById('publicMapData');
      if (!source) {
        return [];
      }

      try {
        return JSON.parse(source.textContent || '[]');
      } catch (error) {
        return [];
      }
    }

    function escapeHtml(value) {
      if (value === null || value === undefined) return '';
      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function currency(value) {
      var amount = parseFloat(value || 0);
      return amount.toLocaleString('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
    }

    function markerColor(state) {
      if (state === 'paid') return '#2f9e44';
      if (state === 'request_funds' || state === 'waiting_funds') return '#f08c00';
      return '#2f7f8f';
    }

    function renderSelectionCard(project) {
      var card = $('#publicMapSelectionCard');
      if (!project) {
        return;
      }

      var imageHtml = project.image_url ?
        '<img class="public-map-card__image" src="' + escapeHtml(project.image_url) + '" alt="' + escapeHtml(project.name) + '" />' :
        '<div class="public-map-card__image" style="display:flex;align-items:center;justify-content:center;background:#f2f7f4;color:#739181;"><i class="fa fa-picture-o" style="font-size:26px;"></i></div>';

      var categoryBadge = project.category_name ? '<span class="public-map-card__badge">' + escapeHtml(project.category_name) + '</span>' : '';
      var stateBadge = project.state_label ? '<span class="public-map-card__badge">' + escapeHtml(project.state_label) + '</span>' : '';

      card.html(
        imageHtml +
        '<h3 class="public-map-card__title">' + escapeHtml(project.name) + '</h3>' +
        '<p class="public-map-card__headline">' + escapeHtml(project.headline || '') + '</p>' +
        '<div>' + categoryBadge + stateBadge + '</div>' +
        '<p class="public-map-card__meta"><i class="fa fa-map-marker"></i> ' + escapeHtml(project.location || 'Localisation non renseignee') + '</p>' +
        '<p class="public-map-card__meta"><i class="fa fa-line-chart"></i> Collecte: <strong>' + currency(project.pledged || 0) + '</strong> / Objectif: ' + currency(project.goal || 0) + '</p>' +
        '<p class="public-map-card__meta"><i class="fa fa-users"></i> ' + parseInt(project.total_contributions || 0, 10) + ' contribution(s)</p>' +
        '<p class="public-map-card__summary">' + escapeHtml(project.summary || '') + '</p>' +
        '<a class="public-map-card__cta" href="' + escapeHtml(project.project_url || '#') + '" target="_blank" rel="noopener">En savoir plus</a>'
      );
    }

    function infoWindowContent(project) {
      return (
        '<div class="public-map-infowindow">' +
          '<h5>' + escapeHtml(project.name) + '</h5>' +
          '<p>' + escapeHtml(project.headline || '') + '</p>' +
          '<p><strong>' + escapeHtml(project.state_label || '') + '</strong> - ' + escapeHtml(project.location || '') + '</p>' +
          '<a href="' + escapeHtml(project.project_url || '#') + '" target="_blank" rel="noopener">En savoir plus</a>' +
        '</div>'
      );
    }

    function initPublicProjectsMap() {
      var mapCanvas = document.getElementById('publicProjectsMap');
      if (!mapCanvas || mapCanvas.dataset.initialized === 'true') {
        return;
      }

      mapCanvas.dataset.initialized = 'true';
      var projects = parseMapData();
      var map = new google.maps.Map(mapCanvas, {
        zoom: 5,
        center: { lat: 7.2, lng: 12.3 },
        mapTypeControl: false,
        streetViewControl: false,
        fullscreenControl: true
      });
      var infoWindow = new google.maps.InfoWindow();

      if (!projects.length) {
        $('#publicMapEmpty').show();
        return;
      }

      var bounds = new google.maps.LatLngBounds();
      var hasMarker = false;

      projects.forEach(function(project, index) {
        var latitude = parseFloat(project.latitude);
        var longitude = parseFloat(project.longitude);

        if (isNaN(latitude) || isNaN(longitude)) {
          return;
        }

        hasMarker = true;
        var marker = new google.maps.Marker({
          position: { lat: latitude, lng: longitude },
          map: map,
          title: project.name,
          icon: {
            path: google.maps.SymbolPath.CIRCLE,
            scale: 9,
            fillColor: markerColor(project.state),
            fillOpacity: 0.95,
            strokeColor: '#ffffff',
            strokeWeight: 2
          }
        });

        marker.addListener('click', function() {
          renderSelectionCard(project);
          infoWindow.setContent(infoWindowContent(project));
          infoWindow.open(map, marker);
        });

        bounds.extend(marker.getPosition());

        if (index === 0) {
          renderSelectionCard(project);
        }
      });

      if (!hasMarker) {
        $('#publicMapEmpty').show();
        return;
      }

      map.fitBounds(bounds);
      google.maps.event.addListenerOnce(map, 'bounds_changed', function() {
        if (map.getZoom() > 10) {
          map.setZoom(10);
        }
      });
    }

    function bootPublicProjectsMap() {
      if (!document.getElementById('publicProjectsMap')) {
        return;
      }

      window.initPublicProjectsMap = initPublicProjectsMap;

      if (window.google && window.google.maps) {
        initPublicProjectsMap();
        return;
      }

      $.getScript('https://maps.googleapis.com/maps/api/js?v=3.exp&sensor=false&callback=initPublicProjectsMap');
    }

    $(document).on('turbolinks:load', bootPublicProjectsMap);
    $(document).ready(bootPublicProjectsMap);
  })();
