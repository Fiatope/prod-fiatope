- content_for :title, 'Carte des projets accompagnes'

- projects_count = @map_projects.size
- maps_api_url = if ENV['GOOGLE_KEY_API'].present?
  "https://maps.googleapis.com/maps/api/js?key=#{ENV['GOOGLE_KEY_API']}&callback=initPublicProjectsMap"
- else
  'https://maps.googleapis.com/maps/api/js?v=3.exp&sensor=false&callback=initPublicProjectsMap'
- end

.public-map-page
  .discover.text-center
    .discover-title Carte des projets accompagnes
    p.public-map-intro
      | Parcourez les projets geolocalises accompagnes sur Fiatope. Cliquez sur un marqueur pour afficher le resume et ouvrir la page complete du projet.
    p.public-map-count
      strong = projects_count
      |  projet(s) geolocalise(s)

  .container
    .row
      .col-md-8
        #publicProjectsMap.public-map-canvas[data-maps-api-url=maps_api_url]
      .col-md-4
        #publicMapSelectionCard.public-map-selection
          .public-map-selection-empty
            h4 Selectionnez un projet
            p Cliquez sur un marqueur de la carte pour afficher le detail ici.

script#publicMapData[type='application/json']
  == @map_projects.to_json

css:
  .public-map-page {
    background: #ffffff;
    padding: 22px 0 36px;
  }

  .public-map-intro {
    max-width: 860px;
    margin: 0 auto 8px;
    color: #54685b;
    font-size: 15px;
  }

  .public-map-count {
    color: #3f5547;
    margin: 0 0 18px;
    font-size: 16px;
  }

  .public-map-canvas {
    width: 100%;
    height: 560px;
    border: 1px solid #e2e8e3;
    border-radius: 4px;
    background: #f7f9f8;
  }

  .public-map-canvas img,
  .public-map-canvas .gm-style img,
  .gm-style img {
    max-width: none !important;
  }

  .public-map-selection {
    min-height: 560px;
    border: 1px solid #e2e8e3;
    border-radius: 4px;
    background: #ffffff;
    padding: 14px;
  }

  .public-map-selection-empty {
    border: 1px dashed #d6e2db;
    border-radius: 4px;
    min-height: 528px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    text-align: center;
    color: #61786b;
    padding: 16px;
  }

  .public-map-card-image {
    width: 100%;
    height: 185px;
    object-fit: cover;
    border-radius: 4px;
    margin-bottom: 10px;
    border: 1px solid #e2e8e3;
  }

  .public-map-card-title {
    margin: 0 0 8px;
    font-size: 22px;
    color: #244631;
    font-weight: 600;
    line-height: 1.25;
  }

  .public-map-card-headline {
    margin: 0 0 10px;
    color: #4b6255;
    font-size: 14px;
  }

  .public-map-card-meta {
    margin: 0 0 8px;
    color: #4c6255;
    font-size: 13px;
  }

  .public-map-card-summary {
    margin: 10px 0;
    color: #44584c;
    font-size: 14px;
    line-height: 1.45;
  }

  .public-map-card-cta {
    display: inline-block;
    margin-top: 8px;
    padding: 9px 14px;
    border: 1px solid #db9500;
    color: #db9500;
    text-decoration: none;
    border-radius: 3px;
    font-weight: 600;
  }

  .public-map-card-cta:hover,
  .public-map-card-cta:focus {
    background: #db9500;
    color: #ffffff;
    text-decoration: none;
  }

  .public-map-inline-alert {
    margin: 16px;
  }

  @media (max-width: 991px) {
    .public-map-canvas {
      height: 420px;
      margin-bottom: 14px;
    }

    .public-map-selection {
      min-height: auto;
    }

    .public-map-selection-empty {
      min-height: 210px;
    }
  }

javascript:
  (function() {
    function parseProjects() {
      var source = document.getElementById('publicMapData');
      if (!source) {
        return [];
      }

      try {
        return JSON.parse(source.textContent || '[]');
      } catch (error) {
        return [];
      }
    }

    function escapeHtml(value) {
      if (value === null || value === undefined) return '';
      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function currency(value) {
      var amount = parseFloat(value || 0);
      return amount.toLocaleString('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
    }

    function showMapMessage(message, kind) {
      var cssClass = kind === 'warning' ? 'alert-warning' : 'alert-info';
      $('#publicProjectsMap').html('<div class="alert ' + cssClass + ' public-map-inline-alert">' + escapeHtml(message) + '</div>');
    }

    function showCardMessage(message) {
      $('#publicMapSelectionCard').html(
        '<div class="public-map-selection-empty">' +
          '<h4>Information</h4>' +
          '<p>' + escapeHtml(message) + '</p>' +
        '</div>'
      );
    }

    function selectionCardHtml(project) {
      var imageHtml = project.image_url ?
        '<img class="public-map-card-image" src="' + escapeHtml(project.image_url) + '" alt="' + escapeHtml(project.name) + '" />' :
        '<div class="public-map-card-image" style="display:flex;align-items:center;justify-content:center;background:#f3f7f4;color:#789181;"><i class="fa fa-picture-o" style="font-size:24px;"></i></div>';

      var categoryLine = project.category_name ? '<p class="public-map-card-meta"><i class="fa fa-tag"></i> ' + escapeHtml(project.category_name) + '</p>' : '';

      return '' +
        imageHtml +
        '<h3 class="public-map-card-title">' + escapeHtml(project.name) + '</h3>' +
        '<p class="public-map-card-headline">' + escapeHtml(project.headline || '') + '</p>' +
        '<p class="public-map-card-meta"><i class="fa fa-map-marker"></i> ' + escapeHtml(project.location || 'Localisation non renseignee') + '</p>' +
        categoryLine +
        '<p class="public-map-card-meta"><i class="fa fa-line-chart"></i> Collecte: <strong>' + currency(project.pledged || 0) + '</strong> / Objectif: ' + currency(project.goal || 0) + '</p>' +
        '<p class="public-map-card-meta"><i class="fa fa-users"></i> ' + parseInt(project.total_contributions || 0, 10) + ' contribution(s)</p>' +
        '<p class="public-map-card-summary">' + escapeHtml(project.summary || '') + '</p>' +
        '<a class="public-map-card-cta" href="' + escapeHtml(project.project_url || '#') + '" target="_blank" rel="noopener">En savoir plus</a>';
    }

    function infoWindowHtml(project) {
      return '' +
        '<div style="max-width:250px;">' +
          '<h5 style="margin:0 0 6px;font-size:15px;color:#244631;">' + escapeHtml(project.name) + '</h5>' +
          '<p style="margin:0 0 8px;font-size:12px;color:#4d6256;">' + escapeHtml(project.location || '') + '</p>' +
          '<a href="' + escapeHtml(project.project_url || '#') + '" target="_blank" rel="noopener" style="font-size:12px;font-weight:600;color:#db9500;">Ouvrir le projet</a>' +
        '</div>';
    }

    function renderSelection(project) {
      $('#publicMapSelectionCard').html(selectionCardHtml(project));
    }

    window.initPublicProjectsMap = function() {
      var mapCanvas = document.getElementById('publicProjectsMap');
      if (!mapCanvas || mapCanvas.dataset.initialized === 'true') {
        return;
      }

      mapCanvas.dataset.initialized = 'true';

      if (!(window.google && window.google.maps)) {
        showMapMessage('La carte Google est indisponible pour le moment.', 'warning');
        showCardMessage('La carte est temporairement indisponible.');
        return;
      }

      var projects = parseProjects();

      if (!projects.length) {
        showMapMessage('Aucun projet geolocalise disponible pour le moment.', 'info');
        showCardMessage('Aucun projet geolocalise disponible pour le moment.');
        return;
      }

      var map = new google.maps.Map(mapCanvas, {
        zoom: 5,
        center: { lat: 6.6111, lng: 12.4578 },
        mapTypeId: 'terrain',
        mapTypeControl: false,
        streetViewControl: false,
        fullscreenControl: true
      });

      var infoWindow = new google.maps.InfoWindow();
      var bounds = new google.maps.LatLngBounds();
      var markersCount = 0;
      var firstProject = null;

      projects.forEach(function(project) {
        var latitude = parseFloat(project.latitude);
        var longitude = parseFloat(project.longitude);

        if (!isFinite(latitude) || !isFinite(longitude)) {
          return;
        }

        markersCount += 1;

        var marker = new google.maps.Marker({
          position: { lat: latitude, lng: longitude },
          map: map,
          title: project.name,
          icon: {
            path: google.maps.SymbolPath.CIRCLE,
            scale: 8,
            fillColor: '#2f7f8f',
            fillOpacity: 0.95,
            strokeColor: '#ffffff',
            strokeWeight: 2
          }
        });

        marker.addListener('click', function() {
          renderSelection(project);
          infoWindow.setContent(infoWindowHtml(project));
          infoWindow.open(map, marker);
        });

        bounds.extend(marker.getPosition());

        if (!firstProject) {
          firstProject = project;
        }
      });

      if (!markersCount) {
        showMapMessage('Aucun projet geolocalise valide disponible.', 'info');
        showCardMessage('Aucun projet geolocalise valide disponible.');
        return;
      }

      map.fitBounds(bounds);

      if (markersCount === 1) {
        map.setZoom(9);
      }

      if (firstProject) {
        renderSelection(firstProject);
      }
    };

    function loadGoogleMapsScript() {
      var mapCanvas = document.getElementById('publicProjectsMap');
      if (!mapCanvas) {
        return;
      }

      if (window.google && window.google.maps) {
        window.initPublicProjectsMap();
        return;
      }

      if (document.getElementById('publicMapGoogleScript')) {
        return;
      }

      var apiUrl = mapCanvas.getAttribute('data-maps-api-url');
      if (!apiUrl) {
        showMapMessage('Configuration Google Maps manquante.', 'warning');
        showCardMessage('Configuration Google Maps manquante.');
        return;
      }

      var script = document.createElement('script');
      script.id = 'publicMapGoogleScript';
      script.async = true;
      script.defer = true;
      script.src = apiUrl;
      script.onerror = function() {
        showMapMessage('Impossible de charger Google Maps pour le moment.', 'warning');
        showCardMessage('Impossible de charger Google Maps pour le moment.');
      };

      document.head.appendChild(script);
    }

    $(document).on('turbolinks:load', loadGoogleMapsScript);
    $(document).ready(loadGoogleMapsScript);
  })();
