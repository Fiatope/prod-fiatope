- content_for :title, 'Carte des projets accompagnes - Fiatope'
- map_stats = @map_stats || {}
- projects_count = map_stats[:projects_count].to_i
- total_contributions = map_stats[:total_contributions].to_i
- total_collected = map_stats[:total_collected].to_f
- maps_api_url = ENV['GOOGLE_KEY_API'].present? ? "https://maps.googleapis.com/maps/api/js?key=#{ENV['GOOGLE_KEY_API']}&callback=initPublicProjectsMap" : 'https://maps.googleapis.com/maps/api/js?v=3.exp&sensor=false&callback=initPublicProjectsMap'

.public-map-page
  .public-map-shell
    .panel.public-map-top
      .panel-body
        .public-map-top__head
          .public-map-top__copy
            p.public-map-top__brand FIATOPE
            h1.public-map-top__title Carte des projets accompagnes
            p.public-map-top__description
              | Une vue publique, claire et geolocalisee des projets accomplis sur Fiatope.
          p.public-map-top__badge Projets accomplis verifies

        .public-map-kpis
          .public-map-kpi
            span.public-map-kpi__label Projets geolocalises
            strong.public-map-kpi__value = number_with_delimiter(projects_count, delimiter: ' ')
          .public-map-kpi
            span.public-map-kpi__label Contributions confirmees
            strong.public-map-kpi__value = number_with_delimiter(total_contributions, delimiter: ' ')
          .public-map-kpi
            span.public-map-kpi__label Montant collecte
            strong.public-map-kpi__value = number_to_currency(total_collected, unit: 'EUR ', precision: 0)

  .public-map-shell
    .public-map-layout
      .public-map-layout__map
        #publicProjectsMap.public-map-canvas[data-maps-api-url=maps_api_url]
      .public-map-layout__details
        #publicMapSelectionCard.public-map-selection
          .public-map-selection-empty
            h4 Selectionnez un projet
            p Cliquez sur un marqueur de la carte pour afficher ses details.

  .public-map-shell
    p.public-map-footnote
      | Les montants et contributions affiches proviennent des donnees publiques confirmees sur Fiatope.

script#publicMapData[type='application/json']
  == @map_projects.to_json

css:
  .public-map-page {
    --public-map-height: clamp(560px, 78vh, 940px);
    background: linear-gradient(180deg, #f4f7f5 0%, #eef3ef 100%);
    padding: 10px 0 22px;
  }

  .public-map-shell {
    width: 100%;
    max-width: none;
    margin: 0 auto;
    padding: 0 10px;
  }

  .public-map-top {
    margin: 0 0 10px;
    border: 1px solid #d8e2dc;
    border-top: 3px solid #a3320c;
    box-shadow: 0 4px 12px rgba(36, 70, 49, 0.07);
  }

  .public-map-top .panel-body {
    padding: 11px 14px;
  }

  .public-map-top__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
  }

  .public-map-top__copy {
    max-width: 920px;
  }

  .public-map-top__brand {
    margin: 0;
    color: #a3320c;
    font-size: 11px;
    letter-spacing: .14em;
    font-weight: 700;
    text-transform: uppercase;
  }

  .public-map-top__title {
    margin: 4px 0 4px;
    color: #214531;
    font-size: 21px;
    line-height: 1.2;
    font-weight: 600;
  }

  .public-map-top__description {
    margin: 0;
    color: #4d6458;
    font-size: 13px;
    line-height: 1.45;
  }

  .public-map-top__badge {
    margin: 0;
    padding: 6px 9px;
    border: 1px solid #d7e2db;
    border-radius: 4px;
    background: #f8fbf9;
    color: #415b4d;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
  }

  .public-map-kpis {
    margin-top: 10px;
    display: grid;
    grid-template-columns: repeat(3, minmax(160px, 1fr));
    gap: 8px;
  }

  .public-map-kpi {
    border: 1px solid #d8e2dc;
    border-radius: 4px;
    background: #fbfdfc;
    padding: 7px 10px;
  }

  .public-map-kpi__label {
    display: block;
    color: #5b7265;
    font-size: 11px;
    line-height: 1.2;
  }

  .public-map-kpi__value {
    display: block;
    margin-top: 3px;
    color: #214531;
    font-size: 15px;
    line-height: 1.2;
    font-weight: 700;
  }

  .public-map-layout {
    display: flex;
    align-items: stretch;
    gap: 10px;
  }

  .public-map-layout__map {
    flex: 1 1 auto;
    min-width: 0;
  }

  .public-map-layout__details {
    flex: 0 0 min(320px, 30vw);
    width: min(320px, 30vw);
    margin-left: auto;
  }

  .public-map-canvas {
    width: 100%;
    height: var(--public-map-height);
    border: 1px solid #d6e2da;
    border-radius: 4px;
    background: #f7faf8;
    box-shadow: 0 6px 18px rgba(36, 70, 49, 0.08);
  }

  .public-map-canvas img,
  .public-map-canvas .gm-style img,
  .gm-style img {
    max-width: none !important;
  }

  .public-map-selection {
    height: var(--public-map-height);
    border: 1px solid #d6e2da;
    border-radius: 4px;
    background: #ffffff;
    box-shadow: 0 6px 18px rgba(36, 70, 49, 0.08);
    padding: 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .public-map-selection-empty {
    flex: 1 1 auto;
    min-height: 0;
    border: 1px dashed #cddbd2;
    border-radius: 4px;
    background: #fbfdfc;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
    color: #5a7365;
    padding: 14px;
  }

  .public-map-selection-empty h4 {
    margin: 0 0 7px;
    color: #2b4c3b;
    font-size: 18px;
    font-weight: 600;
  }

  .public-map-selection-empty p {
    margin: 0;
    font-size: 13px;
    line-height: 1.4;
  }

  .public-map-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .public-map-card-image {
    width: 100%;
    height: 174px;
    object-fit: cover;
    object-position: center center;
    border: 1px solid #dce7df;
    border-radius: 4px;
    margin-bottom: 9px;
    background: #f4f8f5;
    flex: 0 0 auto;
  }

  .public-map-card-content {
    flex: 1 1 auto;
    min-height: 0;
    overflow: auto;
    padding-right: 2px;
  }

  .public-map-card-content::-webkit-scrollbar {
    width: 6px;
  }

  .public-map-card-content::-webkit-scrollbar-thumb {
    background: #d2ddd6;
    border-radius: 6px;
  }

  .public-map-card-title {
    margin: 0 0 6px;
    color: #234733;
    font-size: 19px;
    line-height: 1.3;
    font-weight: 600;
    word-break: break-word;
  }

  .public-map-card-headline {
    margin: 0 0 7px;
    color: #4e6458;
    font-size: 13px;
    line-height: 1.45;
    word-break: break-word;
  }

  .public-map-card-meta {
    margin: 0 0 6px;
    color: #4c6256;
    font-size: 13px;
    line-height: 1.35;
  }

  .public-map-card-summary {
    margin: 7px 0 2px;
    color: #43594d;
    font-size: 13px;
    line-height: 1.5;
    word-break: break-word;
  }

  .public-map-card-cta-wrap {
    flex: 0 0 auto;
    margin-top: 10px;
  }

  .public-map-card-cta {
    display: inline-block;
    padding: 8px 12px;
    border: 1px solid #db9500;
    border-radius: 4px;
    color: #db9500;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    background: #ffffff;
    transition: all .2s ease;
    outline: none;
    box-shadow: none;
  }

  .public-map-card-cta:hover,
  .public-map-card-cta:focus,
  .public-map-card-cta:active {
    background: #db9500;
    color: #ffffff;
    text-decoration: none;
    outline: none;
    box-shadow: none;
  }

  .gm-style .public-map-infowindow-link,
  .gm-style .public-map-infowindow-link:focus,
  .gm-style .public-map-infowindow-link:hover,
  .gm-style .public-map-infowindow-link:active {
    display: inline-block;
    padding: 6px 10px;
    border: 1px solid #db9500;
    border-radius: 4px;
    color: #db9500 !important;
    background: #ffffff;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none !important;
    outline: none !important;
    box-shadow: none !important;
  }

  .gm-style .public-map-infowindow-link:hover,
  .gm-style .public-map-infowindow-link:focus,
  .gm-style .public-map-infowindow-link:active {
    color: #ffffff !important;
    background: #db9500;
  }

  .public-map-inline-alert {
    margin: 16px;
  }

  .public-map-footnote {
    margin: 10px 0 0;
    color: #637d6e;
    font-size: 12px;
  }

  @media (max-width: 1200px) {
    .public-map-page {
      --public-map-height: clamp(520px, 72vh, 820px);
    }

    .public-map-layout__details {
      flex-basis: min(302px, 31vw);
      width: min(302px, 31vw);
    }

    .public-map-card-title {
      font-size: 18px;
    }
  }

  @media (max-width: 991px) {
    .public-map-page {
      --public-map-height: 520px;
    }

    .public-map-shell {
      padding: 0 8px;
    }

    .public-map-top .panel-body {
      padding: 10px 12px;
    }

    .public-map-top__head {
      flex-direction: column;
      gap: 8px;
    }

    .public-map-top__title {
      font-size: 19px;
    }

    .public-map-top__description {
      font-size: 12px;
    }

    .public-map-top__badge {
      white-space: normal;
    }

    .public-map-kpis {
      grid-template-columns: repeat(2, minmax(130px, 1fr));
    }

    .public-map-layout {
      flex-direction: column;
      gap: 8px;
    }

    .public-map-layout__details {
      width: 100%;
      flex-basis: auto;
      margin-left: 0;
    }

    .public-map-selection {
      height: auto;
      max-height: none;
    }

    .public-map-selection-empty {
      min-height: 200px;
    }
  }

  @media (max-width: 680px) {
    .public-map-page {
      --public-map-height: 420px;
      padding-top: 6px;
    }

    .public-map-kpis {
      grid-template-columns: 1fr;
    }

    .public-map-card-image {
      height: 162px;
    }
  }

javascript:
  (function() {
    var MARKER_COLOR = '#2f7f8f';

    function byId(id) {
      return document.getElementById(id);
    }

    function setHtml(element, html) {
      if (element) {
        element.innerHTML = html;
      }
    }

    function parseProjects() {
      var source = byId('publicMapData');
      if (!source) {
        return [];
      }

      try {
        return JSON.parse(source.textContent || '[]');
      } catch (error) {
        return [];
      }
    }

    function escapeHtml(value) {
      if (value === null || value === undefined) {
        return '';
      }

      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function decodeEntities(value) {
      var textarea = document.createElement('textarea');
      textarea.innerHTML = String(value || '');
      return textarea.value;
    }

    function cleanText(value) {
      var text = decodeEntities(value);

      return String(text)
        .replace(/!\[[^\]]*\]\([^\)]+\)/g, ' ')
        .replace(/\[([^\]]+)\]\(([^\)]+)\)/g, '$1')
        .replace(/https?:\/\/\S+/g, ' ')
        .replace(/[|`*_>#]/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();
    }

    function truncateText(value, maxLength) {
      var text = cleanText(value);
      if (text.length <= maxLength) {
        return text;
      }

      return text.slice(0, maxLength).replace(/\s+\S*$/, '') + '...';
    }

    function sanitizeImageUrl(value) {
      var url = String(value || '').trim();
      if (!url) {
        return '';
      }

      if (/^(https?:)?\/\//i.test(url) || /^\//.test(url) || /^data:image\//i.test(url)) {
        return url;
      }

      return '';
    }

    function toNumber(value) {
      var parsed = parseFloat(value);
      return isFinite(parsed) ? parsed : 0;
    }

    function currency(value) {
      return toNumber(value).toLocaleString('fr-FR', {
        style: 'currency',
        currency: 'EUR',
        maximumFractionDigits: 0
      });
    }

    function showMapMessage(message, type) {
      var cssClass = type === 'warning' ? 'alert-warning' : 'alert-info';
      setHtml(byId('publicProjectsMap'), '<div class="alert ' + cssClass + ' public-map-inline-alert">' + escapeHtml(message) + '</div>');
    }

    function showCardMessage(title, message) {
      setHtml(
        byId('publicMapSelectionCard'),
        '<div class="public-map-selection-empty">' +
          '<h4>' + escapeHtml(title) + '</h4>' +
          '<p>' + escapeHtml(message) + '</p>' +
        '</div>'
      );
    }

    function cardImageHtml(project) {
      var primaryImageUrl = sanitizeImageUrl(project.image_url);
      var fallbackImageUrl = sanitizeImageUrl(project.fallback_image_url);
      var imageUrl = primaryImageUrl || fallbackImageUrl;

      if (!imageUrl) {
        return '<div class="public-map-card-image" style="display:flex;align-items:center;justify-content:center;color:#789181;"><i class="fa fa-picture-o" style="font-size:24px;"></i></div>';
      }

      return '<img class="public-map-card-image" src="' + escapeHtml(imageUrl) + '" alt="' + escapeHtml(project.name || 'Projet') + '" loading="lazy" />';
    }

    function selectionCardHtml(project) {
      var categoryLine = project.category_name
        ? '<p class="public-map-card-meta"><i class="fa fa-tag"></i> ' + escapeHtml(truncateText(project.category_name, 70)) + '</p>'
        : '';

      return '' +
        '<article class="public-map-card">' +
          cardImageHtml(project) +
          '<div class="public-map-card-content">' +
            '<h3 class="public-map-card-title">' + escapeHtml(truncateText(project.name || '', 95)) + '</h3>' +
            '<p class="public-map-card-headline">' + escapeHtml(truncateText(project.headline || '', 150)) + '</p>' +
            '<p class="public-map-card-meta"><i class="fa fa-map-marker"></i> ' + escapeHtml(truncateText(project.location || 'Localisation non renseignee', 90)) + '</p>' +
            categoryLine +
            '<p class="public-map-card-meta"><i class="fa fa-line-chart"></i> Collecte: <strong>' + currency(project.pledged) + '</strong> / Objectif: ' + currency(project.goal) + '</p>' +
            '<p class="public-map-card-meta"><i class="fa fa-users"></i> ' + Math.max(0, parseInt(project.total_contributions || 0, 10) || 0) + ' contribution(s)</p>' +
            '<p class="public-map-card-summary">' + escapeHtml(truncateText(project.summary || '', 390)) + '</p>' +
          '</div>' +
          '<div class="public-map-card-cta-wrap">' +
            '<a class="public-map-card-cta" href="' + escapeHtml(project.project_url || '#') + '" target="_blank" rel="noopener">En savoir plus</a>' +
          '</div>' +
        '</article>';
    }

    function infoWindowHtml(project) {
      return '' +
        '<div style="max-width:255px;">' +
          '<h5 style="margin:0 0 6px;font-size:15px;color:#244631;line-height:1.35;">' + escapeHtml(truncateText(project.name || '', 70)) + '</h5>' +
          '<p style="margin:0 0 10px;font-size:12px;color:#4d6256;">' + escapeHtml(truncateText(project.location || '', 70)) + '</p>' +
          '<a class="public-map-infowindow-link" href="' + escapeHtml(project.project_url || '#') + '" target="_blank" rel="noopener" tabindex="-1">Ouvrir le projet</a>' +
        '</div>';
    }

    function attachCardImageFallback(project) {
      var card = byId('publicMapSelectionCard');
      var fallbackImageUrl = sanitizeImageUrl(project.fallback_image_url);

      if (!card || !fallbackImageUrl) {
        return;
      }

      var imageNode = card.querySelector('.public-map-card-image');
      if (!imageNode || imageNode.tagName.toLowerCase() !== 'img') {
        return;
      }

      imageNode.addEventListener('error', function onImageError() {
        imageNode.removeEventListener('error', onImageError);

        if (imageNode.src !== fallbackImageUrl) {
          imageNode.src = fallbackImageUrl;
        }
      });
    }

    function renderSelection(project) {
      setHtml(byId('publicMapSelectionCard'), selectionCardHtml(project));
      attachCardImageFallback(project);
    }

    window.initPublicProjectsMap = function() {
      var mapCanvas = byId('publicProjectsMap');
      if (!mapCanvas || mapCanvas.dataset.initialized === 'true') {
        return;
      }

      mapCanvas.dataset.initialized = 'true';

      if (!(window.google && window.google.maps)) {
        showMapMessage('La carte Google est indisponible pour le moment.', 'warning');
        showCardMessage('Information', 'La carte est temporairement indisponible.');
        return;
      }

      var projects = parseProjects();
      if (!projects.length) {
        showMapMessage('Aucun projet geolocalise disponible pour le moment.', 'info');
        showCardMessage('Information', 'Aucun projet geolocalise disponible pour le moment.');
        return;
      }

      var map = new google.maps.Map(mapCanvas, {
        zoom: 5,
        center: { lat: 6.6111, lng: 12.4578 },
        mapTypeId: 'terrain',
        mapTypeControl: false,
        streetViewControl: false,
        fullscreenControl: true
      });

      var infoWindow = new google.maps.InfoWindow();
      var bounds = new google.maps.LatLngBounds();
      var markersCount = 0;
      var firstMarker = null;

      projects.forEach(function(project) {
        var latitude = toNumber(project.latitude);
        var longitude = toNumber(project.longitude);

        if (!isFinite(latitude) || !isFinite(longitude)) {
          return;
        }

        var marker = new google.maps.Marker({
          position: { lat: latitude, lng: longitude },
          map: map,
          title: project.name || '',
          icon: {
            path: google.maps.SymbolPath.CIRCLE,
            scale: 8,
            fillColor: MARKER_COLOR,
            fillOpacity: 0.95,
            strokeColor: '#ffffff',
            strokeWeight: 2
          }
        });

        marker.addListener('click', function() {
          renderSelection(project);
          infoWindow.setContent(infoWindowHtml(project));
          infoWindow.open(map, marker);
        });

        bounds.extend(marker.getPosition());
        markersCount += 1;

        if (!firstMarker) {
          firstMarker = marker;
        }
      });

      if (!markersCount) {
        showMapMessage('Aucun projet geolocalise valide disponible.', 'info');
        showCardMessage('Information', 'Aucun projet geolocalise valide disponible.');
        return;
      }

      map.fitBounds(bounds);

      if (markersCount === 1) {
        map.setZoom(9);
      }

      if (firstMarker) {
        google.maps.event.trigger(firstMarker, 'click');
      }
    };

    function loadGoogleMapsScript() {
      var mapCanvas = byId('publicProjectsMap');
      if (!mapCanvas) {
        return;
      }

      if (window.google && window.google.maps) {
        window.initPublicProjectsMap();
        return;
      }

      if (byId('publicMapGoogleScript')) {
        return;
      }

      var apiUrl = mapCanvas.getAttribute('data-maps-api-url');
      if (!apiUrl) {
        showMapMessage('Configuration Google Maps manquante.', 'warning');
        showCardMessage('Information', 'Configuration Google Maps manquante.');
        return;
      }

      var script = document.createElement('script');
      script.id = 'publicMapGoogleScript';
      script.async = true;
      script.defer = true;
      script.src = apiUrl;
      script.onerror = function() {
        showMapMessage('Impossible de charger Google Maps pour le moment.', 'warning');
        showCardMessage('Information', 'Impossible de charger Google Maps pour le moment.');
      };

      document.head.appendChild(script);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadGoogleMapsScript);
    } else {
      loadGoogleMapsScript();
    }

    document.addEventListener('turbolinks:load', loadGoogleMapsScript);
  })();