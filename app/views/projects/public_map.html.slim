- content_for :title, 'Carte des projets accompagnes'
- projects_count = @map_projects.size
- maps_api_url = ENV['GOOGLE_KEY_API'].present? ? "https://maps.googleapis.com/maps/api/js?key=#{ENV['GOOGLE_KEY_API']}&callback=initPublicProjectsMap" : 'https://maps.googleapis.com/maps/api/js?v=3.exp&sensor=false&callback=initPublicProjectsMap'

.public-map-page
  .public-map-shell
    .public-map-top
      p.public-map-top__brand FIATOPE
      h1.public-map-top__title Carte des projets accompagnes
      p.public-map-top__description
        | Fiatope accompagne les initiatives a impact sur le terrain. Cette carte publique presente les projets finances avec des donnees verifiees sur la plateforme.
      p.public-map-top__stats
        strong = projects_count
        |  projets geolocalises et consultables

  .public-map-shell
    .row.public-map-grid
      .col-lg-9.col-md-8
        #publicProjectsMap.public-map-canvas[data-maps-api-url=maps_api_url]
      .col-lg-3.col-md-4
        #publicMapSelectionCard.public-map-selection
          .public-map-selection-empty
            h4 Selectionnez un projet
            p Cliquez sur un marqueur de la carte pour afficher ses details.

  .public-map-shell
    p.public-map-footnote
      | Les montants et contributions affiches proviennent des donnees publiques confirmees sur Fiatope.

script#publicMapData[type='application/json']
  == @map_projects.to_json

css:
  .public-map-page {
    background: #f6f8f7;
    padding: 16px 0 30px;
  }

  .public-map-shell {
    width: calc(100vw - 18px);
    max-width: 1860px;
    margin: 0 auto;
  }

  .public-map-top {
    background: #ffffff;
    border: 1px solid #d9e3dc;
    border-top: 4px solid #a3320c;
    border-radius: 6px;
    padding: 18px 16px 16px;
    margin-bottom: 14px;
    box-shadow: 0 6px 18px rgba(36, 70, 49, 0.08);
  }

  .public-map-top__brand {
    margin: 0;
    color: #a3320c;
    font-size: 12px;
    letter-spacing: .14em;
    font-weight: 700;
  }

  .public-map-top__title {
    margin: 6px 0 8px;
    color: #234733;
    font-size: 48px;
    line-height: 1.15;
    font-weight: 600;
  }

  .public-map-top__description {
    margin: 0;
    color: #50675a;
    font-size: 15px;
    line-height: 1.55;
    max-width: 1160px;
  }

  .public-map-top__stats {
    margin: 10px 0 0;
    color: #425a4d;
    font-size: 14px;
  }

  .public-map-grid {
    margin: 0 -8px;
  }

  .public-map-grid > [class*='col-'] {
    padding: 0 8px;
  }

  .public-map-canvas {
    width: 100%;
    height: 720px;
    border: 1px solid #d8e4dc;
    border-radius: 6px;
    background: #f7faf8;
    box-shadow: 0 8px 20px rgba(36, 70, 49, 0.08);
  }

  .public-map-canvas img,
  .public-map-canvas .gm-style img,
  .gm-style img {
    max-width: none !important;
  }

  .public-map-selection {
    min-height: 720px;
    border: 1px solid #d8e4dc;
    border-radius: 6px;
    background: #ffffff;
    box-shadow: 0 8px 20px rgba(36, 70, 49, 0.08);
    padding: 14px;
  }

  .public-map-selection-empty {
    min-height: 688px;
    border: 1px dashed #cddbd2;
    border-radius: 6px;
    background: #fbfdfc;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
    color: #5a7365;
    padding: 16px;
  }

  .public-map-selection-empty h4 {
    margin: 0 0 8px;
    color: #2b4c3b;
    font-size: 24px;
    font-weight: 600;
  }

  .public-map-selection-empty p {
    margin: 0;
    font-size: 15px;
    line-height: 1.45;
  }

  .public-map-card-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    object-position: center center;
    border: 1px solid #dce7df;
    border-radius: 6px;
    margin-bottom: 12px;
    background: #f4f8f5;
  }

  .public-map-card-title {
    margin: 0 0 8px;
    color: #234733;
    font-size: 36px;
    line-height: 1.22;
    font-weight: 600;
    word-break: break-word;
  }

  .public-map-card-headline {
    margin: 0 0 10px;
    color: #4e6458;
    font-size: 14px;
    line-height: 1.45;
    word-break: break-word;
  }

  .public-map-card-meta {
    margin: 0 0 8px;
    color: #4c6256;
    font-size: 13px;
  }

  .public-map-card-summary {
    margin: 10px 0 12px;
    color: #43594d;
    font-size: 14px;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
    word-break: break-word;
  }

  .public-map-card-cta {
    display: inline-block;
    padding: 9px 14px;
    border: 1px solid #db9500;
    border-radius: 4px;
    color: #db9500;
    text-decoration: none;
    font-weight: 600;
    background: #ffffff;
    transition: all .2s ease;
    outline: none;
    box-shadow: none;
  }

  .public-map-card-cta:hover,
  .public-map-card-cta:focus {
    background: #db9500;
    color: #ffffff;
    text-decoration: none;
    outline: none;
    box-shadow: none;
  }

  .public-map-infowindow-link {
    display: inline-block;
    padding: 6px 10px;
    border: 1px solid #db9500;
    border-radius: 4px;
    color: #db9500 !important;
    background: #ffffff;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none !important;
    outline: none !important;
    box-shadow: none !important;
  }

  .public-map-infowindow-link:hover,
  .public-map-infowindow-link:focus {
    background: #db9500;
    color: #ffffff !important;
    text-decoration: none !important;
    outline: none !important;
    box-shadow: none !important;
  }

  .gm-style a,
  .gm-style a:focus,
  .gm-style a:active,
  .gm-style button,
  .gm-style button:focus {
    outline: none !important;
    box-shadow: none !important;
  }

  .public-map-inline-alert {
    margin: 16px;
  }

  .public-map-footnote {
    margin: 10px 0 0;
    color: #667f70;
    font-size: 12px;
  }

  @media (max-width: 1450px) {
    .public-map-canvas {
      height: 670px;
    }

    .public-map-selection {
      min-height: 670px;
    }

    .public-map-selection-empty {
      min-height: 638px;
    }

    .public-map-card-title {
      font-size: 30px;
    }
  }

  @media (max-width: 991px) {
    .public-map-shell {
      width: calc(100vw - 12px);
    }

    .public-map-top__title {
      font-size: 34px;
    }

    .public-map-canvas {
      height: 500px;
      margin-bottom: 14px;
    }

    .public-map-selection {
      min-height: auto;
    }

    .public-map-selection-empty {
      min-height: 230px;
    }

    .public-map-card-title {
      font-size: 30px;
    }
  }

javascript:
  (function() {
    var MARKER_COLOR = '#2f7f8f';

    function byId(id) {
      return document.getElementById(id);
    }

    function setHtml(element, html) {
      if (element) {
        element.innerHTML = html;
      }
    }

    function parseProjects() {
      var source = byId('publicMapData');
      if (!source) {
        return [];
      }

      try {
        return JSON.parse(source.textContent || '[]');
      } catch (error) {
        return [];
      }
    }

    function escapeHtml(value) {
      if (value === null || value === undefined) {
        return '';
      }

      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function cleanText(value) {
      return String(value || '')
        .replace(/!\[[^\]]*\]\([^)]+\)/g, ' ')
        .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '$1')
        .replace(/https?:\/\/\S+/g, ' ')
        .replace(/[|`*_>#]/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();
    }

    function truncateText(value, maxLength) {
      var text = cleanText(value);
      if (text.length <= maxLength) {
        return text;
      }

      return text.slice(0, maxLength).replace(/\s+\S*$/, '') + '...';
    }

    function toNumber(value) {
      var parsed = parseFloat(value);
      return isFinite(parsed) ? parsed : 0;
    }

    function currency(value) {
      return toNumber(value).toLocaleString('fr-FR', {
        style: 'currency',
        currency: 'EUR',
        maximumFractionDigits: 0
      });
    }

    function showMapMessage(message, type) {
      var cssClass = type === 'warning' ? 'alert-warning' : 'alert-info';
      setHtml(byId('publicProjectsMap'), '<div class="alert ' + cssClass + ' public-map-inline-alert">' + escapeHtml(message) + '</div>');
    }

    function showCardMessage(title, message) {
      setHtml(
        byId('publicMapSelectionCard'),
        '<div class="public-map-selection-empty">' +
          '<h4>' + escapeHtml(title) + '</h4>' +
          '<p>' + escapeHtml(message) + '</p>' +
        '</div>'
      );
    }

    function cardImageHtml(project) {
      var imageUrl = cleanText(project.image_url || project.fallback_image_url || '');
      if (!imageUrl) {
        return '<div class="public-map-card-image" style="display:flex;align-items:center;justify-content:center;color:#789181;"><i class="fa fa-picture-o" style="font-size:24px;"></i></div>';
      }

      return '<img class="public-map-card-image" src="' + escapeHtml(imageUrl) + '" alt="' + escapeHtml(project.name || 'Projet') + '" loading="lazy" />';
    }

    function selectionCardHtml(project) {
      var categoryLine = project.category_name
        ? '<p class="public-map-card-meta"><i class="fa fa-tag"></i> ' + escapeHtml(truncateText(project.category_name, 70)) + '</p>'
        : '';

      return '' +
        cardImageHtml(project) +
        '<h3 class="public-map-card-title">' + escapeHtml(truncateText(project.name || '', 95)) + '</h3>' +
        '<p class="public-map-card-headline">' + escapeHtml(truncateText(project.headline || '', 150)) + '</p>' +
        '<p class="public-map-card-meta"><i class="fa fa-map-marker"></i> ' + escapeHtml(truncateText(project.location || 'Localisation non renseignee', 80)) + '</p>' +
        categoryLine +
        '<p class="public-map-card-meta"><i class="fa fa-line-chart"></i> Collecte: <strong>' + currency(project.pledged) + '</strong> / Objectif: ' + currency(project.goal) + '</p>' +
        '<p class="public-map-card-meta"><i class="fa fa-users"></i> ' + Math.max(0, parseInt(project.total_contributions || 0, 10) || 0) + ' contribution(s)</p>' +
        '<p class="public-map-card-summary">' + escapeHtml(truncateText(project.summary || '', 260)) + '</p>' +
        '<a class="public-map-card-cta" href="' + escapeHtml(project.project_url || '#') + '" target="_blank" rel="noopener">En savoir plus</a>';
    }

    function infoWindowHtml(project) {
      return '' +
        '<div style="max-width:255px;">' +
          '<h5 style="margin:0 0 6px;font-size:15px;color:#244631;line-height:1.35;">' + escapeHtml(truncateText(project.name || '', 70)) + '</h5>' +
          '<p style="margin:0 0 10px;font-size:12px;color:#4d6256;">' + escapeHtml(truncateText(project.location || '', 70)) + '</p>' +
          '<a class="public-map-infowindow-link" href="' + escapeHtml(project.project_url || '#') + '" target="_blank" rel="noopener">Ouvrir le projet</a>' +
        '</div>';
    }

    function attachCardImageFallback(project) {
      var card = byId('publicMapSelectionCard');
      if (!card || !project.fallback_image_url) {
        return;
      }

      var imageNode = card.querySelector('.public-map-card-image');
      if (!imageNode || imageNode.tagName.toLowerCase() !== 'img') {
        return;
      }

      imageNode.addEventListener('error', function onImageError() {
        imageNode.removeEventListener('error', onImageError);
        imageNode.src = project.fallback_image_url;
      });
    }

    function renderSelection(project) {
      setHtml(byId('publicMapSelectionCard'), selectionCardHtml(project));
      attachCardImageFallback(project);
    }

    window.initPublicProjectsMap = function() {
      var mapCanvas = byId('publicProjectsMap');
      if (!mapCanvas || mapCanvas.dataset.initialized === 'true') {
        return;
      }

      mapCanvas.dataset.initialized = 'true';

      if (!(window.google && window.google.maps)) {
        showMapMessage('La carte Google est indisponible pour le moment.', 'warning');
        showCardMessage('Information', 'La carte est temporairement indisponible.');
        return;
      }

      var projects = parseProjects();
      if (!projects.length) {
        showMapMessage('Aucun projet geolocalise disponible pour le moment.', 'info');
        showCardMessage('Information', 'Aucun projet geolocalise disponible pour le moment.');
        return;
      }

      var map = new google.maps.Map(mapCanvas, {
        zoom: 5,
        center: { lat: 6.6111, lng: 12.4578 },
        mapTypeId: 'terrain',
        mapTypeControl: false,
        streetViewControl: false,
        fullscreenControl: true
      });

      var infoWindow = new google.maps.InfoWindow();
      var bounds = new google.maps.LatLngBounds();
      var markersCount = 0;
      var firstMarker = null;

      projects.forEach(function(project) {
        var latitude = toNumber(project.latitude);
        var longitude = toNumber(project.longitude);

        if (!isFinite(latitude) || !isFinite(longitude)) {
          return;
        }

        var marker = new google.maps.Marker({
          position: { lat: latitude, lng: longitude },
          map: map,
          title: project.name || '',
          icon: {
            path: google.maps.SymbolPath.CIRCLE,
            scale: 8,
            fillColor: MARKER_COLOR,
            fillOpacity: 0.95,
            strokeColor: '#ffffff',
            strokeWeight: 2
          }
        });

        marker.addListener('click', function() {
          renderSelection(project);
          infoWindow.setContent(infoWindowHtml(project));
          infoWindow.open(map, marker);
        });

        bounds.extend(marker.getPosition());
        markersCount += 1;

        if (!firstMarker) {
          firstMarker = marker;
        }
      });

      if (!markersCount) {
        showMapMessage('Aucun projet geolocalise valide disponible.', 'info');
        showCardMessage('Information', 'Aucun projet geolocalise valide disponible.');
        return;
      }

      map.fitBounds(bounds);

      if (markersCount === 1) {
        map.setZoom(9);
      }

      if (firstMarker) {
        google.maps.event.trigger(firstMarker, 'click');
      }
    };

    function loadGoogleMapsScript() {
      var mapCanvas = byId('publicProjectsMap');
      if (!mapCanvas) {
        return;
      }

      if (window.google && window.google.maps) {
        window.initPublicProjectsMap();
        return;
      }

      if (byId('publicMapGoogleScript')) {
        return;
      }

      var apiUrl = mapCanvas.getAttribute('data-maps-api-url');
      if (!apiUrl) {
        showMapMessage('Configuration Google Maps manquante.', 'warning');
        showCardMessage('Information', 'Configuration Google Maps manquante.');
        return;
      }

      var script = document.createElement('script');
      script.id = 'publicMapGoogleScript';
      script.async = true;
      script.defer = true;
      script.src = apiUrl;
      script.onerror = function() {
        showMapMessage('Impossible de charger Google Maps pour le moment.', 'warning');
        showCardMessage('Information', 'Impossible de charger Google Maps pour le moment.');
      };

      document.head.appendChild(script);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadGoogleMapsScript);
    } else {
      loadGoogleMapsScript();
    }

    document.addEventListener('turbolinks:load', loadGoogleMapsScript);
  })();