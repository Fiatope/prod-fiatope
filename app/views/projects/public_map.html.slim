- content_for :title, 'Carte des projets accompagnes'
- projects_count = @map_projects.size
- maps_api_url = ENV['GOOGLE_KEY_API'].present? ? "https://maps.googleapis.com/maps/api/js?key=#{ENV['GOOGLE_KEY_API']}&callback=initPublicProjectsMap" : 'https://maps.googleapis.com/maps/api/js?v=3.exp&sensor=false&callback=initPublicProjectsMap'

.public-map-page
  .container
    .public-map-header
      p.public-map-header__brand FIATOPE
      h1 Carte des projets accompagnes
      p.public-map-header__description
        | Fiatope met en avant des initiatives financees par sa communaute. Explorez la carte, consultez les resumes et accedez a chaque projet en un clic.
      .public-map-header__chips
        span.public-map-chip
          strong = projects_count
          |  projets geolocalises
        span.public-map-chip Donnees publiques confirmees
        span.public-map-chip Impact local visible

  .container
    .row
      .col-md-8
        #publicProjectsMap.public-map-canvas[data-maps-api-url=maps_api_url]
      .col-md-4
        #publicMapSelectionCard.public-map-selection
          .public-map-selection-empty
            h4 Selectionnez un projet
            p Cliquez sur un marqueur de la carte pour afficher ses details.

    p.public-map-footnote
      | Les montants et contributions affiches proviennent des informations publiques confirmees sur la plateforme.

script#publicMapData[type='application/json']
  == @map_projects.to_json

css:
  .public-map-page {
    background: linear-gradient(180deg, #f8faf9 0%, #ffffff 220px);
    padding: 26px 0 40px;
  }

  .public-map-header {
    background: #ffffff;
    border: 1px solid #e4ebe6;
    border-top: 4px solid #db9500;
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(36, 70, 49, 0.08);
    padding: 18px 20px;
    margin-bottom: 18px;
  }

  .public-map-header__brand {
    margin: 0;
    color: #a3320c;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .public-map-header h1 {
    margin: 6px 0 8px;
    color: #244631;
    font-size: 34px;
    line-height: 1.2;
    font-weight: 600;
  }

  .public-map-header__description {
    margin: 0;
    color: #4f6558;
    font-size: 15px;
    line-height: 1.55;
    max-width: 980px;
  }

  .public-map-header__chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 14px;
  }

  .public-map-chip {
    display: inline-block;
    background: #f6f9f7;
    border: 1px solid #dbe5de;
    color: #365445;
    border-radius: 999px;
    font-size: 12px;
    padding: 5px 10px;
  }

  .public-map-chip strong {
    color: #2a4838;
  }

  .public-map-canvas {
    width: 100%;
    height: 560px;
    border: 1px solid #dfe8e2;
    border-radius: 6px;
    background: #f7faf8;
    box-shadow: 0 6px 18px rgba(36, 70, 49, 0.06);
  }

  .public-map-canvas img,
  .public-map-canvas .gm-style img,
  .gm-style img {
    max-width: none !important;
  }

  .public-map-selection {
    min-height: 560px;
    border: 1px solid #dfe8e2;
    border-radius: 6px;
    background: #ffffff;
    box-shadow: 0 6px 18px rgba(36, 70, 49, 0.06);
    padding: 14px;
  }

  .public-map-selection-empty {
    border: 1px dashed #d3e1d8;
    border-radius: 6px;
    min-height: 528px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    text-align: center;
    color: #5f7668;
    padding: 18px;
    background: #fbfdfc;
  }

  .public-map-selection-empty h4 {
    margin: 0 0 8px;
    color: #2d4b3b;
    font-size: 31px;
    font-weight: 500;
  }

  .public-map-selection-empty p {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
  }

  .public-map-card-image {
    width: 100%;
    height: 190px;
    object-fit: cover;
    border-radius: 6px;
    margin-bottom: 12px;
    border: 1px solid #dfe8e2;
  }

  .public-map-card-title {
    margin: 0 0 8px;
    color: #244631;
    font-size: 26px;
    line-height: 1.2;
    font-weight: 600;
  }

  .public-map-card-headline {
    margin: 0 0 10px;
    color: #4f6558;
    font-size: 14px;
    line-height: 1.45;
  }

  .public-map-card-meta {
    margin: 0 0 8px;
    color: #50665a;
    font-size: 13px;
  }

  .public-map-card-summary {
    margin: 10px 0 12px;
    color: #455b4e;
    font-size: 14px;
    line-height: 1.5;
  }

  .public-map-card-cta {
    display: inline-block;
    margin-top: 8px;
    padding: 9px 14px;
    border: 1px solid #db9500;
    color: #db9500;
    text-decoration: none;
    border-radius: 4px;
    font-weight: 600;
    transition: all .2s ease;
  }

  .public-map-card-cta:hover,
  .public-map-card-cta:focus {
    background: #db9500;
    color: #ffffff;
    text-decoration: none;
  }

  .public-map-inline-alert {
    margin: 16px;
  }

  .public-map-footnote {
    margin: 12px 0 0;
    font-size: 12px;
    color: #6b8174;
  }

  @media (max-width: 991px) {
    .public-map-header h1 {
      font-size: 28px;
    }

    .public-map-canvas {
      height: 420px;
      margin-bottom: 14px;
    }

    .public-map-selection {
      min-height: auto;
    }

    .public-map-selection-empty {
      min-height: 220px;
    }
  }

javascript:
  (function() {
    var BRAND_COLOR = '#db9500';
    var MARKER_COLOR = '#2f7f8f';

    function byId(id) {
      return document.getElementById(id);
    }

    function setHtml(element, html) {
      if (element) {
        element.innerHTML = html;
      }
    }

    function parseProjects() {
      var source = byId('publicMapData');
      if (!source) {
        return [];
      }

      try {
        return JSON.parse(source.textContent || '[]');
      } catch (error) {
        return [];
      }
    }

    function escapeHtml(value) {
      if (value === null || value === undefined) {
        return '';
      }

      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function currency(value) {
      var amount = parseFloat(value || 0);
      return amount.toLocaleString('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
    }

    function showMapMessage(message, type) {
      var cssClass = type === 'warning' ? 'alert-warning' : 'alert-info';
      setHtml(byId('publicProjectsMap'), '<div class="alert ' + cssClass + ' public-map-inline-alert">' + escapeHtml(message) + '</div>');
    }

    function showCardMessage(title, message) {
      setHtml(
        byId('publicMapSelectionCard'),
        '<div class="public-map-selection-empty">' +
          '<h4>' + escapeHtml(title) + '</h4>' +
          '<p>' + escapeHtml(message) + '</p>' +
        '</div>'
      );
    }

    function selectionCardHtml(project) {
      var imageHtml = project.image_url
        ? '<img class="public-map-card-image" src="' + escapeHtml(project.image_url) + '" alt="' + escapeHtml(project.name) + '" />'
        : '<div class="public-map-card-image" style="display:flex;align-items:center;justify-content:center;background:#f3f7f4;color:#789181;"><i class="fa fa-picture-o" style="font-size:24px;"></i></div>';

      var categoryLine = project.category_name
        ? '<p class="public-map-card-meta"><i class="fa fa-tag"></i> ' + escapeHtml(project.category_name) + '</p>'
        : '';

      return '' +
        imageHtml +
        '<h3 class="public-map-card-title">' + escapeHtml(project.name) + '</h3>' +
        '<p class="public-map-card-headline">' + escapeHtml(project.headline || '') + '</p>' +
        '<p class="public-map-card-meta"><i class="fa fa-map-marker"></i> ' + escapeHtml(project.location || 'Localisation non renseignee') + '</p>' +
        categoryLine +
        '<p class="public-map-card-meta"><i class="fa fa-line-chart"></i> Collecte: <strong>' + currency(project.pledged || 0) + '</strong> / Objectif: ' + currency(project.goal || 0) + '</p>' +
        '<p class="public-map-card-meta"><i class="fa fa-users"></i> ' + parseInt(project.total_contributions || 0, 10) + ' contribution(s)</p>' +
        '<p class="public-map-card-summary">' + escapeHtml(project.summary || '') + '</p>' +
        '<a class="public-map-card-cta" href="' + escapeHtml(project.project_url || '#') + '" target="_blank" rel="noopener">En savoir plus</a>';
    }

    function infoWindowHtml(project) {
      return '' +
        '<div style="max-width:250px;">' +
          '<h5 style="margin:0 0 6px;font-size:15px;color:#244631;">' + escapeHtml(project.name) + '</h5>' +
          '<p style="margin:0 0 8px;font-size:12px;color:#4d6256;">' + escapeHtml(project.location || '') + '</p>' +
          '<a href="' + escapeHtml(project.project_url || '#') + '" target="_blank" rel="noopener" style="font-size:12px;font-weight:600;color:' + BRAND_COLOR + ';">Ouvrir le projet</a>' +
        '</div>';
    }

    function renderSelection(project) {
      setHtml(byId('publicMapSelectionCard'), selectionCardHtml(project));
    }

    window.initPublicProjectsMap = function() {
      var mapCanvas = byId('publicProjectsMap');
      if (!mapCanvas || mapCanvas.dataset.initialized === 'true') {
        return;
      }

      mapCanvas.dataset.initialized = 'true';

      if (!(window.google && window.google.maps)) {
        showMapMessage('La carte Google est indisponible pour le moment.', 'warning');
        showCardMessage('Information', 'La carte est temporairement indisponible.');
        return;
      }

      var projects = parseProjects();
      if (!projects.length) {
        showMapMessage('Aucun projet geolocalise disponible pour le moment.', 'info');
        showCardMessage('Information', 'Aucun projet geolocalise disponible pour le moment.');
        return;
      }

      var map = new google.maps.Map(mapCanvas, {
        zoom: 5,
        center: { lat: 6.6111, lng: 12.4578 },
        mapTypeId: 'terrain',
        mapTypeControl: false,
        streetViewControl: false,
        fullscreenControl: true
      });

      var infoWindow = new google.maps.InfoWindow();
      var bounds = new google.maps.LatLngBounds();
      var markersCount = 0;
      var firstMarker = null;

      projects.forEach(function(project) {
        var latitude = parseFloat(project.latitude);
        var longitude = parseFloat(project.longitude);

        if (!isFinite(latitude) || !isFinite(longitude)) {
          return;
        }

        var marker = new google.maps.Marker({
          position: { lat: latitude, lng: longitude },
          map: map,
          title: project.name,
          icon: {
            path: google.maps.SymbolPath.CIRCLE,
            scale: 8,
            fillColor: MARKER_COLOR,
            fillOpacity: 0.95,
            strokeColor: '#ffffff',
            strokeWeight: 2
          }
        });

        marker.addListener('click', function() {
          renderSelection(project);
          infoWindow.setContent(infoWindowHtml(project));
          infoWindow.open(map, marker);
        });

        bounds.extend(marker.getPosition());
        markersCount += 1;

        if (!firstMarker) {
          firstMarker = marker;
        }
      });

      if (!markersCount) {
        showMapMessage('Aucun projet geolocalise valide disponible.', 'info');
        showCardMessage('Information', 'Aucun projet geolocalise valide disponible.');
        return;
      }

      map.fitBounds(bounds);

      if (markersCount === 1) {
        map.setZoom(9);
      }

      if (firstMarker) {
        google.maps.event.trigger(firstMarker, 'click');
      }
    };

    function loadGoogleMapsScript() {
      var mapCanvas = byId('publicProjectsMap');
      if (!mapCanvas) {
        return;
      }

      if (window.google && window.google.maps) {
        window.initPublicProjectsMap();
        return;
      }

      if (byId('publicMapGoogleScript')) {
        return;
      }

      var apiUrl = mapCanvas.getAttribute('data-maps-api-url');
      if (!apiUrl) {
        showMapMessage('Configuration Google Maps manquante.', 'warning');
        showCardMessage('Information', 'Configuration Google Maps manquante.');
        return;
      }

      var script = document.createElement('script');
      script.id = 'publicMapGoogleScript';
      script.async = true;
      script.defer = true;
      script.src = apiUrl;
      script.onerror = function() {
        showMapMessage('Impossible de charger Google Maps pour le moment.', 'warning');
        showCardMessage('Information', 'Impossible de charger Google Maps pour le moment.');
      };

      document.head.appendChild(script);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadGoogleMapsScript);
    } else {
      loadGoogleMapsScript();
    }

    document.addEventListener('turbolinks:load', loadGoogleMapsScript);
  })();