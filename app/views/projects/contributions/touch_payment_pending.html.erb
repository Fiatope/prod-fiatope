<% content_for :title, t('.title') %>

<div class="contribution-page">
  <%= hero_header_tag @project do %>
    <div class="large-10 columns large-centered text-center">
      <h3><%= t('.title') %></h3>
    </div>
  <% end %>

  <div class="row page-main-content">
    <div class="col-md-6 col-md-offset-3 text-center" style="padding: 40px 20px;">

      <div style="margin-bottom: 30px;">
        <i class="fa fa-mobile" style="font-size: 64px; color: #f69219;"></i>
      </div>

      <h4><%= t('.waiting_title') %></h4>
      <p><%= t('.waiting_message') %></p>

      <div style="margin: 30px 0;">
        <div class="progress" style="height: 8px; border-radius: 4px; background: #eee;">
          <div class="progress-bar progress-bar-striped active" id="progress-bar"
               style="width: 100%; background: #f69219; border-radius: 4px;
                      animation: progress-pulse 1.5s ease-in-out infinite;">
          </div>
        </div>
        <small style="color: #999; display: block; margin-top: 8px;">
          <span id="check-counter">0</span> <%= t('.checks_done') %>
        </small>
      </div>

      <p id="status-message" style="color: #666; font-size: 13px;"><%= t('.mobile_instruction') %></p>

      <% if params[:touch_timeout] %>
        <div class="alert-box warning" style="margin-top: 15px; padding: 10px; background: #fff3cd; border: 1px solid #ffc107; border-radius: 4px; color: #856404;">
          <%= t('.timeout_message') %>
        </div>
      <% end %>

      <div style="margin-top: 20px;">
        <%= link_to t('.back_to_project'), project_path(@project), class: 'btn btn-default btn-sm' %>
      </div>

    </div>
  </div>
</div>

<style>
@keyframes progress-pulse {
  0%   { opacity: 1; }
  50%  { opacity: 0.4; }
  100% { opacity: 1; }
}
</style>

<script>
(function() {
  var checkUrl      = '<%= touch_payment_check_status_project_contribution_path(@project, @contribution) %>';
  var successUrl    = '<%= project_contribution_path(project_id: @project, id: @contribution) %>';
  var canceledUrl   = '<%= edit_project_contribution_path(project_id: @project, id: @contribution) %>';
  var pendingUrl    = '<%= touch_payment_pending_project_contribution_path(@project, @contribution) %>';
  var projectUrl    = '<%= project_path(@project) %>';
  var storageKey    = 'touch_checks_<%= @contribution.id %>';
  var maxChecks     = 60;   // 5 minutes max (60 x 5s)
  var interval      = 5000; // 5 seconds
  var counter       = document.getElementById('check-counter');
  var statusMsg     = document.getElementById('status-message');

  // If this page was loaded with touch_timeout=1, stop polling — we already timed out
  var isTimeout = (window.location.search.indexOf('touch_timeout=1') !== -1);
  if (isTimeout) {
    if (counter) counter.closest && counter.closest('div') && (counter.closest('div').style.display = 'none');
    return; // Do NOT start polling again
  }

  // Persist counter across page refreshes via localStorage
  var checks = 0;
  try {
    var stored = parseInt(localStorage.getItem(storageKey) || '0', 10);
    if (!isNaN(stored) && stored > 0 && stored < maxChecks) {
      checks = stored;
      if (counter) counter.textContent = checks;
    }
  } catch(e) {}

  function saveChecks() { try { localStorage.setItem(storageKey, checks); } catch(e) {} }
  function clearChecks() { try { localStorage.removeItem(storageKey); } catch(e) {} }

  function checkStatus() {
    checks++;
    saveChecks();
    if (counter) counter.textContent = checks;

    fetch(checkUrl, {
      method: 'GET',
      headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.confirmed) {
        clearChecks();
        window.location.href = successUrl;
      } else if (data.canceled) {
        clearChecks();
        window.location.href = canceledUrl;
      } else if (data.state === 'unauthorized') {
        clearChecks();
        window.location.href = projectUrl;
      } else if (checks >= maxChecks) {
        clearChecks();
        window.location.href = pendingUrl + '?touch_timeout=1';
      } else {
        if (statusMsg && checks > 10) {
          statusMsg.textContent = '<%= t(".mobile_instruction_retry") %>';
        }
        setTimeout(checkStatus, interval);
      }
    })
    .catch(function() {
      if (checks < maxChecks) {
        setTimeout(checkStatus, interval);
      } else {
        clearChecks();
        window.location.href = pendingUrl + '?touch_timeout=1';
      }
    });
  }

  // Start checking after 3 seconds
  setTimeout(checkStatus, 3000);
})();
</script>
