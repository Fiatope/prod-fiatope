- content_for :title, "Paiement des fonds - #{@project.name}"
= render 'projects/meta_tags'

.project-page
  = render 'projects/shortheader'

  .row.padding-20
    .col-md-10.col-md-offset-1
      /= Données pré-calculées
      - payout_ready = @stripe_payout_ready
      - stripe_waiting = @payout_profile_complete && !payout_ready && !@payout_profile_edit_unlocked
      - payout_status = @project.stripe_payout_status.to_s
      - payout_paid = @project.state == 'paid'
      - payout_processing = %w[pending in_transit].include?(payout_status)
      - payout_failed = %w[failed canceled].include?(payout_status)
      - transfer_done = @project.stripe_settlement_type == 'transferred' || @project.stripe_transfer_id.present?
      - payout_requires_action = transfer_done && !payout_paid && !payout_processing && !payout_failed
      - already_paid  = payout_paid && !payout_failed
      - payout_pending = (@project.state == 'request_funds' || payout_processing || payout_failed || payout_requires_action) && !already_paid
      - stripe_contribs = @project.contributions.where(payment_method: 'Stripe', state: 'confirmed')
      - total_collected = stripe_contribs.sum(:value)
      - contribs_count = stripe_contribs.count
      - fee_pct = ENV.fetch('PLATFORM_FEE', '5.0').tr(',', '.').to_f
      - platform_fee_amount = (total_collected * fee_pct / 100).round(2)
      - net_to_receive = (total_collected - platform_fee_amount).round(2)
      /= Frais de paiement (info interne - inclus dans la commission, PAS soustrait en plus)
      - stripe_fees_estimate = (contribs_count * 0.25 + total_collected * 0.029).round(2)
      - current_step = already_paid ? 4 : (payout_pending ? 3 : (payout_ready ? 2 : 1))
      - required_kyc_types = @required_kyc_types || []
      - required_kyc_labels = @required_kyc_labels || {}
      - existing_kyc_docs = @kyc_documents_by_type || {}
      - missing_fields = Array(@payout_profile_missing_fields)
      - missing_documents = missing_fields.select { |field| field.to_s.start_with?('Document manquant:') }.map { |field| field.to_s.sub(/\ADocument manquant:\s*/, '') }
      - missing_information = missing_fields.reject { |field| field.to_s.start_with?('Document manquant:') }

      / ===== TRACKER D'ÉTAPES VISUEL =====
      .panel.radius[style="background:#f8f9fa;border:1px solid #e9ecef;margin-bottom:25px;padding:20px 15px 10px;"]
        .row.text-center
          - steps = [{ icon: 'fa-file-text-o', label: 'Documents', desc: 'À fournir' }, { icon: 'fa-paper-plane', label: 'Demande', desc: 'À envoyer' }, { icon: 'fa-clock-o', label: 'Paiement', desc: 'En cours' }, { icon: 'fa-check-circle', label: 'Reçu', desc: 'Fonds reçus' }]
          - steps.each_with_index do |step, i|
            - step_num = i + 1
            - is_done = step_num < current_step
            - is_current = step_num == current_step
            - color = is_done ? '#27ae60' : (is_current ? '#2980b9' : '#bdc3c7')
            .col-md-3.col-xs-6[style="margin-bottom:10px;"]
              .text-center
                span[style="display:inline-block;width:40px;height:40px;line-height:40px;border-radius:50%;background:#{color};color:#fff;font-size:18px;"]
                  - if is_done
                    i.fa.fa-check
                  - else
                    i.fa[class=step[:icon]]
                p[style="margin:5px 0 0;font-weight:#{is_current ? 'bold' : 'normal'};color:#{color};"]
                  = step[:label]
                p.small[style="color:#95a5a6;margin:0;"] = step[:desc]

      / ===== RÉSUMÉ FINANCIER DÉTAILLÉ =====
      .panel.radius[style="margin-bottom:25px;border:1px solid #e7ddc8;background:#fff;padding:0;overflow:hidden;"]
        h4[style="margin:0;padding:14px 18px;background:#fffdf7;border-bottom:1px solid #e7ddc8;color:#b9770e;"]
          i.fa.fa-bar-chart
          |  Résumé financier de votre campagne
        - if total_collected > 0
          table[style="width:100%;border-collapse:collapse;color:#2d3436;"]
            tr[style="border-bottom:1px solid #ecf0f1;"]
              td[style="padding:12px 18px;"] Montant collecté (#{contribs_count} contribution#{'s' if contribs_count > 1})
              td.text-right[style="padding:12px 18px;font-weight:bold;white-space:nowrap;"] #{number_to_currency(total_collected, unit: '€', separator: ',', delimiter: ' ', format: '%n %u')}
            tr[style="border-bottom:1px solid #ecf0f1;"]
              td[style="padding:12px 18px;"]
                | Commission Fiatope
                small[style="color:#58656d;"]  (#{fee_pct}%, frais bancaires inclus)
              td.text-right[style="padding:12px 18px;color:#8a6d3b;white-space:nowrap;"] - #{number_to_currency(platform_fee_amount, unit: '€', separator: ',', delimiter: ' ', format: '%n %u')}
            tr[style="border-top:2px solid #27ae60;background:#fbfffd;"]
              td[style="padding:14px 18px;font-weight:bold;font-size:1.1em;"] Montant net que vous recevrez
              td.text-right[style="padding:14px 18px;font-weight:bold;font-size:1.3em;color:#1f8a4c;white-space:nowrap;"] #{number_to_currency(net_to_receive, unit: '€', separator: ',', delimiter: ' ', format: '%n %u')}
          p.small[style="color:#58656d;margin:12px 18px 16px;line-height:1.5;"]
            i.fa.fa-info-circle
            |  La commission couvre les frais bancaires et le service Fiatope.
        - else
          p.text-center[style="color:#95a5a6;padding:20px;"]
            i.fa.fa-inbox[style="font-size:2em;display:block;margin-bottom:10px;"]
            | Aucune contribution confirmée pour le moment.

      / ===== ZONE D'ACTION (selon l'étape) =====
      - if already_paid
        .panel.radius[style="background:#d5f5e3;border:2px solid #27ae60;padding:20px;margin-bottom:25px;"]
          h4[style="color:#27ae60;"]
            i.fa.fa-check-circle
            |  Fonds reçus sur votre compte bancaire
          p
            | Le paiement a été confirmé sur votre compte bancaire.
          - paid_date = @project.stripe_payout_paid_at || @project.stripe_settled_at
          - if paid_date.present?
            p
              i.fa.fa-calendar
              strong |  Date de confirmation :
              = l(paid_date, format: :long)

      - elsif payout_processing && !@payout_profile_edit_unlocked
        .panel.radius[style="background:#eef5ff;border:1px solid #7aa7e0;padding:20px;margin-bottom:25px;"]
          h4[style="color:#2f6fb2;"]
            i.fa.fa-clock-o
            |  Paiement en cours
          p
            | Le paiement vers votre compte bancaire est en cours. Vous recevrez un email lorsque les fonds seront arrivés.
          - if @project.stripe_payout_arrival_date.present?
            p.small
              i.fa.fa-calendar
              |  Date estimée d’arrivée : #{l(@project.stripe_payout_arrival_date.to_date, format: :long)}

      - elsif payout_failed && !@payout_profile_edit_unlocked
        .panel.radius[style="background:#fff7e6;border:1px solid #f0c36d;padding:20px;margin-bottom:25px;"]
          h4[style="color:#8a6d3b;"]
            i.fa.fa-exclamation-triangle
            |  Paiement à reprendre
          p
            | Le paiement n'a pas pu être finalisé. Notre équipe va vérifier vos documents et vous recontactera si une correction est nécessaire.

      - elsif payout_pending && !@payout_profile_edit_unlocked
        .panel.radius[style="background:#eef5ff;border:1px solid #7aa7e0;padding:20px;margin-bottom:25px;"]
          h4[style="color:#2f6fb2;"]
            i.fa.fa-clock-o
            |  Demande de paiement envoyée
          p
            | Votre demande de paiement de
            strong #{number_to_currency(net_to_receive, unit: '€', separator: ',', delimiter: ' ', format: '%n %u')}
            |  est entre les mains de notre équipe.
          p
            | Nous vérifions vos documents. Vous recevrez un email à chaque étape importante.

      - elsif !payout_ready || @payout_profile_edit_unlocked
        .panel.radius[style="background:#fffdf7;border:1px solid #f0d8a8;padding:20px;margin-bottom:25px;"]
          h4[style="color:#b9770e;"]
            i.fa.fa-id-card
            - if stripe_waiting
              |  Documents envoyés
            - elsif @payout_profile_edit_unlocked
              |  Corriger mes informations et documents
            - else
              |  Documents nécessaires au paiement
          - if stripe_waiting
            p
              | Vos informations et documents ont été envoyés. Nous vous contacterons seulement si une correction est nécessaire.
          - else
            p
              | Pour recevoir vos fonds, indiquez :
            .panel.radius[style="background:#fff;border:1px solid #e7ddc8;padding:12px 15px;margin:10px 0 18px;"]
              p[style="margin:0 0 6px;"]
                strong vos informations et celles de votre structure :
                - if missing_information.any?
                  |  #{missing_information.join(', ')}
                - else
                  |  vérifiez les champs ci-dessous.
              p[style="margin:0;"]
                strong vos documents :
                - if missing_documents.any?
                  |  #{missing_documents.join(', ')}
                - elsif required_kyc_types.any?
                  |  vérifiez les fichiers ci-dessous.
                - else
                  |  aucun nouveau document à envoyer.

          = form_tag update_payout_profile_project_path(@project), method: :put, multipart: true, class: 'js-payout-profile-form' do
            .row
              .col-md-12
                .form-group
                  label for="name" Nom complet du titulaire
                  = text_field_tag :name, current_user.name, class: 'form-control', required: true

            .row
              .col-md-4
                .form-group
                  label for="birthday" Date de naissance
                  = date_field_tag :birthday, current_user.birthday, class: 'form-control', required: true
              .col-md-4
                .form-group
                  label for="nationality" Nationalité (code pays)
                  = text_field_tag :nationality, current_user.nationality, class: 'form-control', placeholder: 'FR', required: true
              .col-md-4
                .form-group
                  label for="residence_country" Pays de résidence (code pays)
                  = text_field_tag :residence_country, current_user.residence_country, class: 'form-control', placeholder: 'FR', required: true

            .row
              .col-md-6
                .form-group
                  label for="organization_name" Nom de l’association / entreprise / organisation
                  = text_field_tag :organization_name, @organization_name, class: 'form-control', placeholder: 'Nom légal de la structure', required: true
              .col-md-6
                .form-group
                  label for="mobile_phone" Téléphone
                  = text_field_tag :mobile_phone, current_user.mobile_phone, class: 'form-control'

            .row
              .col-md-12
                .form-group
                  label for="organization_registration_number" Numéro SIREN, SIRET ou RNA
                  = text_field_tag :organization_registration_number, @organization_registration_number, class: 'form-control', placeholder: 'Ex: 123456789 ou W123456789', required: true

            .row
              .col-md-6
                .form-group
                  label for="owner_address" Adresse du titulaire du compte
                  = text_field_tag :owner_address, @bank_information.owner_address, class: 'form-control', required: true
              .col-md-3
                .form-group
                  label for="owner_city" Ville
                  = text_field_tag :owner_city, @bank_information.owner_city, class: 'form-control', required: true
              .col-md-3
                .form-group
                  label for="owner_region" Région / État si applicable
                  = text_field_tag :owner_region, @bank_information.owner_region, class: 'form-control'

            .row
              .col-md-3
                .form-group
                  label for="owner_postal_code" Code postal
                  = text_field_tag :owner_postal_code, @bank_information.owner_postal_code, class: 'form-control', required: true
              .col-md-3
                .form-group
                  label for="other_country" Pays du compte bancaire
                  = text_field_tag :other_country, @bank_information.other_country.presence || current_user.residence_country, class: 'form-control', placeholder: 'FR'
              .col-md-6
                .form-group
                  = hidden_field_tag :bank_reference_type, 'iban'
                  label for="bank_reference_value" IBAN
                  = text_field_tag :bank_reference_value, @bank_reference_value, class: 'form-control', required: true, placeholder: 'FR76...'
                  p.small.text-muted[style="margin-top:5px;"]
                    | Un IBAN est nécessaire pour recevoir le paiement.

            .panel.radius[style="background:#fff;margin-top:15px;padding:15px;"]
              h5
                i.fa.fa-id-card
                |  Documents à fournir
              - required_kyc_types.each do |proof_type|
                - existing_docs = Array(existing_kyc_docs[proof_type])
                - label = required_kyc_labels[proof_type] || proof_type.humanize
                - accepted_formats = proof_type == 'IDENTITY_PROOF' ? '.jpg,.jpeg,.png' : '.jpg,.jpeg,.png,.pdf'
                - accepted_formats_label = proof_type == 'IDENTITY_PROOF' ? 'JPG, JPEG, PNG' : 'JPG, JPEG, PNG, PDF'
                .form-group
                  label = label
                  = file_field_tag "kyc_files[#{proof_type}][]", class: 'form-control', multiple: true, accept: accepted_formats
                  p.small.text-muted[style="margin-top:5px;"]
                    | Formats acceptés : #{accepted_formats_label}. Vous pouvez envoyer plusieurs fichiers (ex : recto/verso).
                  - if existing_docs.any?
                    p.small.text-muted[style="margin-top:8px;margin-bottom:6px;"]
                      | Documents déjà envoyés :
                    .d-flex.flex-wrap[style="margin-top:4px;"]
                      - existing_docs.each do |existing_doc|
                        - next unless existing_doc.uploaded_image.present?
                        - doc_url = existing_doc.uploaded_image.url
                        - doc_name = existing_doc.uploaded_image_identifier.presence || 'Document'
                        - doc_extension = File.extname(doc_name.to_s).delete('.').downcase
                        - if %w[jpg jpeg png gif webp].include?(doc_extension)
                          = link_to doc_url, target: '_blank', class: 'mr-2 mb-2', style: 'display:inline-block;' do
                            = image_tag doc_url, alt: doc_name, style: 'height:72px;width:auto;border:1px solid #dee2e6;border-radius:4px;padding:2px;background:#fff;'
                        - elsif doc_extension == 'pdf'
                          = link_to doc_url, target: '_blank', class: 'btn btn-sm btn-outline-primary mr-2 mb-2' do
                            i.fa.fa-file-pdf-o.mr-1
                            = doc_name
                        - else
                          = link_to doc_name, doc_url, target: '_blank', class: 'btn btn-sm btn-outline-secondary mr-2 mb-2'

            .text-center[style="margin-top:20px;"]
              .form-group.text-left[style="max-width:760px;margin:0 auto 15px;"]
                label[style="font-weight:normal;"]
                  = check_box_tag :organization_single_representative_attestation, '1', false, required: true, class: 'js-payout-required-checkbox'
                  |  La personne renseignée est la seule personne à déclarer pour cette structure.
              = hidden_field_tag :stripe_tos_acceptance, '1'
              button.btn.btn-lg.btn-warning[type="submit" disabled=true style="padding:12px 40px;font-size:1.1em;"]
                i.fa.fa-save
                |  Envoyer mes informations et documents

          javascript:
            document.addEventListener('DOMContentLoaded', function() {
              Array.prototype.slice.call(document.querySelectorAll('.js-payout-profile-form')).forEach(function(form) {
                var requiredCheckboxes = Array.prototype.slice.call(form.querySelectorAll('.js-payout-required-checkbox'));
                var submitButtons = Array.prototype.slice.call(form.querySelectorAll('button[type="submit"], input[type="submit"]'));
                var refreshSubmitState = function() {
                  var allChecked = requiredCheckboxes.length === 0 || requiredCheckboxes.every(function(checkbox) { return checkbox.checked; });
                  submitButtons.forEach(function(button) { button.disabled = !allChecked; });
                };

                requiredCheckboxes.forEach(function(checkbox) {
                  checkbox.addEventListener('change', refreshSubmitState);
                });
                refreshSubmitState();
              });
            });

      - else
        - if total_collected <= 0
          .panel.radius[style="background:#eaf2f8;border:2px solid #3498db;padding:20px;margin-bottom:25px;"]
            p.text-center[style="color:#7f8c8d;"]
              i.fa.fa-inbox[style="font-size:2em;display:block;margin-bottom:10px;"]
              | Votre espace est configuré ! Les fonds apparaîtront ici dès que vos contributeurs auront payé.
        - else
          .panel.radius[style="background:#eaf2f8;border:2px solid #27ae60;padding:20px;margin-bottom:25px;"]
            .text-center
              p[style="color:#27ae60;font-size:1.1em;"]
                i.fa.fa-check-circle
                strong |  Tout est prêt !
                |  Vos documents sont prêts et vos contributions sont confirmées.
              = form_tag request_payout_project_path(@project), method: :post, style: 'margin-top:15px;' do
                button.btn.btn-lg.btn-success[type="submit" style="padding:14px 50px;font-size:1.2em;" data-confirm="Confirmer la demande de paiement de #{number_to_currency(net_to_receive, unit: '€', separator: ',', delimiter: ' ', format: '%n %u')} ?"]
                  i.fa.fa-paper-plane
                  |  Demander le paiement
              p.small[style="color:#95a5a6;margin-top:12px;"]
                i.fa.fa-shield
                |  Après validation par notre équipe, le paiement est généralement traité sous 2 à 7 jours ouvrés.

      / ===== DÉTAIL DES CONTRIBUTIONS =====
      - if contribs_count > 0
        .panel.radius[style="margin-bottom:25px;"]
          h4[style="margin-bottom:15px;"]
            i.fa.fa-users
            |  Vos #{contribs_count} contributeur#{'s' if contribs_count > 1}
          table.table.table-striped[style="margin-bottom:0;"]
            thead
              tr[style="background:#f8f9fa;"]
                th #
                th Contributeur
                th.text-right Montant
                th.text-right Commission
                th.text-right[style="color:#27ae60;"] Net
                th Date
            tbody
              - stripe_contribs.includes(:user).order(confirmed_at: :desc).each_with_index do |c, i|
                - c_fee = (c.value * fee_pct / 100).round(2)
                - c_net = (c.value - c_fee).round(2)
                tr
                  td = i + 1
                  td
                    = c.user&.name || 'Anonyme'
                  td.text-right = number_to_currency(c.value, unit: '€', separator: ',', delimiter: ' ', format: '%n %u')
                  td.text-right[style="color:#e67e22;"] - #{number_to_currency(c_fee, unit: '€', separator: ',', delimiter: ' ', format: '%n %u')}
                  td.text-right[style="color:#27ae60;font-weight:bold;"] #{number_to_currency(c_net, unit: '€', separator: ',', delimiter: ' ', format: '%n %u')}
                  td
                    small = (c.confirmed_at || c.created_at)&.strftime('%d/%m/%Y %H:%M')

      / ===== SECTION FAQ =====
      .panel.radius[style="background:#f8f9fa;border:1px solid #e9ecef;margin-bottom:25px;padding:20px;"]
        h4
          i.fa.fa-question-circle
          |  Questions fréquentes
        .row
          .col-md-6
            p
              strong | Quand vais-je recevoir mes fonds ?
            p.small | Après votre demande, notre équipe vérifie vos documents et déclenche le paiement. Vous recevrez un email lorsque les fonds seront arrivés.
            p
              strong | Que couvrent les frais ?
            p.small | La commission de #{fee_pct}% couvre le traitement sécurisé des cartes bancaires et les frais de service Fiatope (support, hébergement, maintenance).
          .col-md-6
            p
              strong | Mes fonds sont-ils en sécurité ?
            p.small | Oui. Les paiements sont traités par un prestataire bancaire spécialisé. Nous vous prévenons par email à chaque étape importante.
            p
              strong | Puis-je rembourser un contributeur ?
            p.small | Si nécessaire, contactez notre équipe. Les remboursements sont possibles avant le transfert des fonds.

      .text-center
        = link_to project_path(@project), class: "btn btn-default" do
          i.fa.fa-arrow-left
          |  Retour au projet
