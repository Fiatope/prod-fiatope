<div class="why text-center">
	<div class="why-text" style="padding-bottom: 10px;">
		<%= 'Statistiques' %>
	</div>
	<div class="container">
		<div class="row">
			<div class="col-sm-6 col-lg-3 text-center">
				<h1 style="color: #DB9500; font-size: 50px; margin-bottom: 20px;">
					<%= @montant_total_collecte * 2 %> €
				</h1>
				<p>
					Collectés 
				</p>
			</div>
			<div class="col-sm-6 col-lg-3 text-center">
				<h1 style="color: #DB9500; font-size: 50px; margin-bottom: 20px;">
					<%= @total_contributeurs * 2 %>
				</h1>
				<p>
					Contributeurs
				</p>
			</div>
			<div class="col-sm-6 col-lg-3 text-center">
				<h1 style="color: #DB9500; font-size: 50px; margin-bottom: 20px;">
					<%= @total_projects_accompagnes * 2 %>
				</h2>
				<p>
					Projets accompagnés
				</p>
			</div>
			<div class="col-sm-6 col-lg-3 text-center">
				<h1 style="color: #DB9500; font-size: 50px; margin-bottom: 20px;">
					<%= @total_pays %>
				</h1>
				<p>
					Pays
				</p>
			</div>
		</div>
	</div>
</div>


