<div class="navbar-wagon p-5">

  <div class="navbar-wagon-brand p-5">
    <% if @partner.uploaded_image.present? %>
      <%= link_to image_tag(@partner.uploaded_image.url, alt: "Logo #{@partner.name}", class: 'logo-partner'), partner_path(id: @partner.permalink) %>
    <% else %>
      <%= link_to image_tag('', alt: "Logo #{@partner.name}", class: 'logo-partner'), partner_path(id: @partner.permalink) %>
    <% end %>
  </div>

  <div class="navbar-wagon-right">
    <div id="b" class="flag">
      &nbsp;&nbsp;FR&nbsp;
      <%= link_to_unless_current image_tag('france.png', alt: 'France', height: 30, width: 30), locale: 'fr' %>
      &nbsp;&nbsp;&nbsp;&nbsp;EN&nbsp;
      <%= link_to_unless_current image_tag('uk.png', alt: 'English', height: 30, width: 30), locale: 'en' %>
     <!-- Right Navigation -->
    </div>

    <!-- Different navigation if login or not -->
    <% if user_signed_in? %>
      <%#= link_to "Cagnottes #{@partner.name}", main_app.partner_path(anchor: 'projects'), class: 'navbar-wagon-item navbar-wagon-link' %>
    <!--</div>-->
      <%#= link_to 'Créer un projet', main_app.new_project_path(partner: @partner), class: 'navbar-wagon-item navbar-wagon-button btn', style: "color: ##{@partner.primary_theme_color}; border: ##{@partner.primary_theme_color} 2px solid; " %>

      <div class="dropdown">
        <div class="dropdown-toggle" data-toggle="dropdown">
          <% if !current_user.uploaded_image.url.nil? %>
            <%= image_tag current_user.uploaded_image.url, id: "avatar-navbar" %>
          <% else %>
            <%= image_tag "anonymous-user.png", id: "avatar-navbar", style: "max-width: 50%; height: auto; border-radius: 50%; margin: 0 15px;" %>  <%= current_user.first_name %> <i class="fa fa-angle-down"></i>
          <% end %>
        </div>

        <ul class="dropdown-menu dropdown-menu-right navbar-wagon-dropdown-menu">
          <li><%= link_to t('Mon profil'), main_app.edit_user_path(current_user) %></li>
          <li>
            <% if I18n.locale == :en %>
              <%= link_to 'Traduire en FR', locale: 'fr' %>
            <% else %>
             <%= link_to 'English version', locale: 'en' %>
            <% end %>
          </li> 
          <li role="separator" class="divider"></li>
            <%# if current_user.projects.any? %>
              <!-- <li> -->
                <%#= link_to main_app.user_projects_path(current_user) do %>
                   <%#= t('Mes projets') %>
                <%# end %>
              <!-- </li> -->
            <%# end %>
          <% if current_user.contributions.any? %>
               <!-- <li>
                <%= link_to main_app.user_contributions_path(current_user) do %>
                  <i class="fa fa-check"></i>  <%= t '.my_contributions', default: 'Mes contributions' %>
                <% end %>
              </li> -->
            <% end %>
             <!-- <li>
              <%= link_to main_app.credits_user_path(current_user) do %>
                <i class="fa fa-money"></i>  <%= t '.credits', default: 'Mes crédits' %>
             <% end %>
            </li>
            <li>
              <%= link_to main_app.payments_user_path(current_user) do %>
                <i class="fa fa-credit-card"></i>  <%= t '.bank_details', default: 'Coordonnées bancaires' %>
              <% end %>
            </li>
            <li>
              <%= link_to main_app.settings_user_path(current_user) do %>
                <i class="fa fa-cog"></i>  <%= t '.settings', default: 'Mes configurations' %>
              <% end %>
            </li> -->
          <li role="separator" class="divider"></li>
          <li><%= link_to t('Se deconnecter'), main_app.destroy_user_session_url, method: :delete %></li>
        </ul>
      </div>
    <% else %>
    <!-- Button (call-to-action) -->
      <%= link_to 'Créer un projet', main_app.new_project_path(partner: @partner), class: 'navbar-wagon-item navbar-wagon-button btn', style: "color: ##{@partner.primary_theme_color}; border: ##{@partner.primary_theme_color} 2px solid; " %>
        <div class="dropdown">
          <div class="dropdown-toggle" data-toggle="dropdown">
            <%= image_tag "anonymous-user.png", id: "avatar-navbar" %> Menu <i class="fa fa-angle-down"></i>
          </div>
          <ul class="dropdown-menu dropdown-menu-right navbar-wagon-dropdown-menu">
            <li><%= link_to t('.sign-in'), main_app.new_user_session_url, class: 'navbar-wagon-item navbar-wagon-link' %>
            <li><%= link_to t('.sign-up'), main_app.new_user_registration_url, class: 'navbar-wagon-item navbar-wagon-link' %>
            <li role="separator" class="divider"></li>
            <li><% if I18n.locale == :en %> <%= link_to 'Traduire en FR', locale: 'fr' %> <% else %> <%= link_to 'English version', locale: 'en' %> <% end %>
            <li role="separator" class="divider"></li>
            <li><%= link_to t('.how_it_work'), main_app.how_it_works_path %></li>
           <!--  <li><%#= link_to t('.cagnotte_publiques'), main_app.discover_path %> -->
            <!-- <li><%#= link_to t('.crowdfunding'), main_app.uncover_path %> -->
            <!-- <li><%#= link_to t('.sign_out'), main_app.destroy_user_session_url(base_domain_with_https_url_params), method: :delete %></li> -->
          </ul>
        </div>
      <% end %>
  </div>

  <!-- Dropdown list appearing on mobile only -->
  <div class="navbar-wagon-item hidden-md hidden-lg">
    <div class="dropdown">
      <i class="fa fa-bars dropdown-toggle" data-toggle="dropdown"></i>
      <ul class="dropdown-menu dropdown-menu-right navbar-wagon-dropdown-menu">
        <!-- <li> -->
          <%#= link_to 'How does it work?', main_app.how_it_works_path %>
        <!-- </li> -->
        <!-- <li> -->
          <%#= link_to "Projets #{@partner.name}", main_app.partner_projects_path %>
        <!-- </li> -->
        <% if user_signed_in? %>
          <li><%= link_to t('.profile'), main_app.edit_user_path(current_user) %></li>
          <li><%= link_to t('.sign_out'), main_app.destroy_user_session_url, method: :delete %></li>
        <% else %>
          <li><%= link_to t('.sign_in', default: 'Connexion'), new_user_session_path, class: 'navbar-wagon-item navbar-wagon-link' %></li>
          <li><%= link_to t('.sign_up', default: 'Inscription'), new_user_registration_path, class: 'navbar-wagon-item navbar-wagon-link' %></li>
        <% end %>
      </ul>
    </div>
  </div>
</div>
