<%= content_for :title, t(".title") %>

<%= content_for :meta_tags do %>
	<meta name="description" content="Annuaire fiatope" />
	<script type="text/javascript" src="//widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" async></script>
	<!-- End TrustBox script -->
    
<% end %>




<div class="s132">
  <form action="annuaire-fiatope/search" action="get">
    <div class="inner-form">
      <div class="input-field second-wrap">
        <input id="search" name="search" type="text" placeholder="Rechercher une startup" />
      </div>
      <div class="input-field third-wrap">
        <%# <button class="btn-search" type="button">Search</button> %>
        <input class="btn-search" type="submit" value="Submit">
      </div>
    </div>
  </form>
</div>

