
<section class="bg-light page-section" id="portfolio">
      <div class="container">
        <div class="row">
          <div class="col-lg-12 text-center">
            <h2 class="section-heading ">Pays d'Afrique Francophone</h2>
            <h3 class="section-subheading text-muted">Découvrez les startups par pays</h3>
          </div>
        </div>
        <div class="row">
    <% @countries.each do |country| %>
 
        
          <div class="col-md-4 col-sm-6 portfolio-item">
            <a class="portfolio-link">
              <div class="portfolio-hover">
                <div class="portfolio-hover-content">
                </div>
              </div>
              <%= link_to image_tag("flags/#{country[:flag]}"), startups_path(country: country[:name]) %>
            </a>
            <div class="portfolio-caption">
              <h4><%= link_to country[:name], startups_path(country: country[:name]) %></h4>
            </div>
          </div>
        
 
<% end %>

</div>
 </section>