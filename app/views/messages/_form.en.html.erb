<div class="row form">
	<div class="col-md-6 col-md-offset-3 text-center">
		<%= form_for @message do |f| %>

		<%= recaptcha_tags %>

		<%= f.label :Name, class: 'strong-label' %>
		<%= f.text_field :name, placeholder: "Enter your name", class:"wrap"%>

		<%= f.label :email, class: 'strong-label' %>
		<%= f.text_field :email, placeholder: "Enter your email"%>

		<%= f.label :subject, class: 'strong-label' %> 
    	<%= f.text_field :subject, placeholder: "Enter your subject"%> 

		<%= f.label :message, class: 'strong-label'  %> 
		<%= f.text_area :message, placeholder: "Give your message" %>

		<%= f.hidden_field :type, value:nil %>

		<%= f.submit :send, class: 'btn-medium-red-nm btn-block' %>

		<% end %>

	</div> 
</div>
