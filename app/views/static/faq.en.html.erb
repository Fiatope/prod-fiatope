				<h4 class="question" id="question20">How to manage your profile? <i id="2" class="fa fa-caret-down" aria-hidden="true"></i></h4>
				<p class="answer" id="answer20">

					<%= image_tag 'Ou_Va_Votre_Contribution_Enhanced.png'%>
