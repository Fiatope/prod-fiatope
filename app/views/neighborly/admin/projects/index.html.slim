- @title = t('.title')
.admin
  .row
    = render 'neighborly/admin/layouts/menu'
    section.content.large-12.columns
      h4
        strong= "#{@total_projects} "
        = t('.total_projects')
      
      /= Flash messages généraux (succès, erreurs, alertes)
      - if flash[:success].present?
        .alert-box.success.flash-message style="margin: 15px 0; padding: 15px; border-radius: 5px;"
          i.fa.fa-check-circle style="margin-right: 8px;"
          = flash[:success]
          a.close href="#" onclick="this.parentElement.style.display='none'; return false;" &times;
      
      - if flash[:alert].present?
        .alert-box.alert.flash-message style="margin: 15px 0; padding: 15px; border-radius: 5px;"
          i.fa.fa-exclamation-triangle style="margin-right: 8px;"
          = flash[:alert]
          a.close href="#" onclick="this.parentElement.style.display='none'; return false;" &times;
      
      - if flash[:notice].present?
        .alert-box.info.flash-message style="margin: 15px 0; padding: 15px; border-radius: 5px;"
          i.fa.fa-info-circle style="margin-right: 8px;"
          = flash[:notice]
          a.close href="#" onclick="this.parentElement.style.display='none'; return false;" &times;
      
      - if flash[:wallet_details].present?
        .alert-box.secondary.flash-message style="margin: 15px 0; padding: 15px; border-radius: 5px; font-family: monospace; font-size: 12px; white-space: pre-line;"
          i.fa.fa-list style="margin-right: 8px;"
          strong Détails vérification wallet:
          br
          = flash[:wallet_details]
          a.close href="#" onclick="this.parentElement.style.display='none'; return false;" &times;
      
      .filters
        = form_tag projects_path, method: :get, class: 'form-horizontal' do |f|
          = hidden_field_tag :order_by, params[:order_by]
          .row
            .large-3.columns
              = label_tag :by_id, t('.id')
              = text_field_tag :by_id, params[:by_id], class: 'input-small'

            - [:between_created_at, :between_expires_at, :between_online_date].each do |between_field|
              .large-3.columns
                = label_tag "#{between_field}_start_at".to_sym, t(".#{between_field}")
                = text_field_tag "#{between_field}[start_at]", (params[between_field][:start_at] if params[between_field].present?)
                | &nbsp;
                | &nbsp;
                = text_field_tag "#{between_field}[ends_at]", (params[between_field][:ends_at] if params[between_field].present?)

          .row
            .large-4.columns
              = label_tag :pg_search, t('.project')
              = text_field_tag :pg_search, params[:pg_search]
            .large-4.columns
              = label_tag :with_state, t('.with_state')
              = select_tag :with_state, options_for_select(Project.state_names, params[:with_state]), include_blank: true
            .large-4.columns
              = label_tag :by_category_id, t('.by_category')
              = select_tag :by_category_id, options_from_collection_for_select(Category.all, :id, :name_pt,params[:by_category_id]), include_blank: true
          .row
            .large-6.columns
              = label_tag :user_name_contains, t('.user')
              = text_field_tag :user_name_contains, params[:user_name_contains]
            .large-6.columns
              = label_tag :by_user_email, t('.by_user_email')
              = text_field_tag :by_user_email, params[:by_user_email]
          .row
            .large-12.columns.text-right
              = submit_tag t('.submit'), class: 'button'
        .row
          .large-6.columns.text-left
              = paginate @projects
          .large-6.columns.text-right
            = pluralize_without_number @projects.to_a.size, t('words.found_singular'), t('words.found_plural')
            | &nbsp;
            strong = @projects.to_a.size
            | &nbsp;
            = pluralize_without_number(@projects.to_a.size, t('words.project_singular'), t('words.project_plural')).downcase
      .data-table
        - if @projects.empty?
          = t('.no_projects')
        - else
          table.small
            thead
              tr
                th style="width: 200px;"
                  = t('.name')
                th= t('.email')
                th= t('.category')
                th= t('.user_id')
                th= t('.user_key')
                th
                  a data-sort="goal" href='#'= t('.goal')
                  span.sort-order
                th
                  a data-sort="pt.progress" href='#'= t('.pledged')
                  span.sort-order
                th
                  a data-sort="pt.total_contributions" href='#'= t('.total_contributions')
                  span.sort-order
                th= t('.recommended')
                th= t('.project_id')
                th
                  a data-sort="online_date" href='#'= t('.online_date')
                  span.sort-order
                th
                  a data-sort="projects.expires_at" href='#'= t('.expires_at')
                  span.sort-order
                th= t('.state')
                th= t('.wallet_id')
                th Stripe
                th= t('.doc')
                th
            tbody
              - @projects.each do |project|
                tr id=project.id
                  td
                    = link_to project.name, main_app.project_path(project)
                    - if project.channels.present?
                      | &nbsp;
                      - project.channels.each do |channel|
                        span.label.label-inverse= channel.name
                        | &nbsp;
                  td= link_to project.user.email, main_app.edit_user_path(project.user)
                  td= project.category
                  td= best_in_place project, :user_id, type: :input
                  td= project.user.mangopay_contributor.try(:key)
                  td= best_in_place project, :goal, type: :input, display_as: :display_goal
                  td= "#{project.display_pledged} (#{project.progress}%)"
                  td= project.total_contributions
                  td.checkbox
                    /= best_in_place project, :recommended, type: :checkbox, collection: [t('words._no'), t('words._yes')]
                    = best_in_place project, :recommended, as: :checkbox, collection: [t('words._no'), t('words._yes')]
                    br
                    = link_to 'Change', main_app.change_recommended_project_path(project), method: :post,  title: 'Change recommended'
                  
                  td= project.id
                  td= project.online_date.to_date if project.online_date
                  td= project.display_expires_at
                  td
                    - if project.online?
                      span.label.label-online= project.state
                    - elsif project.successful?
                      span.label.label-success= project.state
                    - elsif project.failed? or project.rejected?
                      span.label.label-important= project.state
                    - elsif project.waiting_funds?
                      span.label.label-warning= project.state
                    - elsif project.canceled?
                      span.label.label-canceled= project.state
                    - elsif project.tobefollowed?
                      span.label.label-tobefollowed= project.state
                    - else 
                      span.label= project.state
                  td
                    - if project.respond_to?(:stripe_wallet_balance) && project.use_stripe?
                      - w_balance = project.stripe_wallet_balance
                      - w_pending = project.stripe_wallet_pending
                      - w_status = project.stripe_wallet_status
                      - if w_balance > 0
                        - case w_status
                        - when :collecting
                          span.label.label-primary title="Brut: #{number_to_currency(w_balance, unit: '€', format: '%n %u')} | En attente: #{number_to_currency(w_pending, unit: '€', format: '%n %u')}"
                            = "💰 #{number_to_currency(w_pending, unit: '€', format: '%n %u')}"
                        - when :transferred
                          span.label.label-success title="Brut collecté: #{number_to_currency(w_balance, unit: '€', format: '%n %u')} — Tout transféré"
                            = "✅ #{number_to_currency(w_balance, unit: '€', format: '%n %u')}"
                        - when :refunded
                          span.label.label-warning title="Brut collecté: #{number_to_currency(w_balance, unit: '€', format: '%n %u')} — Tout remboursé"
                            = "↩️ #{number_to_currency(w_balance, unit: '€', format: '%n %u')}"
                        - when :partial
                          - w_transferred = project.stripe_wallet_transferred
                          - w_refunded = project.stripe_wallet_refunded
                          span.label.label-info title="Brut: #{number_to_currency(w_balance, unit: '€', format: '%n %u')} | Transféré: #{number_to_currency(w_transferred, unit: '€', format: '%n %u')} | Remboursé: #{number_to_currency(w_refunded, unit: '€', format: '%n %u')}"
                            = "📊 #{number_to_currency(w_balance, unit: '€', format: '%n %u')}"
                        - when :mixed
                          span.label.label-warning title="Brut: #{number_to_currency(w_balance, unit: '€', format: '%n %u')} | En attente: #{number_to_currency(w_pending, unit: '€', format: '%n %u')}"
                            = "⚡ #{number_to_currency(w_pending, unit: '€', format: '%n %u')}"
                      - else
                        span.label.label-default title="Aucune contribution Stripe" —
                    - else
                      = project.mangopay_wallet_handler.try(:wallet_key)
                  td
                    - if project.respond_to?(:use_stripe?)
                      - if project.use_stripe?
                        - stripe_account = project.stripe_account_id.presence || project.user.stripe_connect_account_id
                        - profile_ready = project.user.payout_profile_complete?
                        - if profile_ready
                          span.label.label-success title="Compte: #{stripe_account}\nProfil de retrait complet" ✅ Profil retrait OK
                        - else
                          span.label.label-warning title="Compte: #{stripe_account}\nLe porteur doit completer son profil de retrait" ⚠️ Profil incomplet
                        - if project.stripe_settlement_type == 'transferred'
                          br
                          span.label.label-info title="Transféré le #{project.stripe_settled_at&.strftime('%d/%m/%Y %H:%M')}" 💰 Transféré
                        - elsif project.stripe_settlement_type == 'refunded'
                          br
                          span.label.label-alert title="Remboursé le #{project.stripe_settled_at&.strftime('%d/%m/%Y %H:%M')}" ↩️ Remboursé
                        - else
                          /= Afficher les contributions EN ATTENTE (non traitées)
                          - stripe_contributions_pending = project.contributions.where(payment_method: 'Stripe', state: 'confirmed').where(stripe_refunded: [false, nil]).where(stripe_transferred: [false, nil])
                          - if stripe_contributions_pending.any?
                            br
                            span.label.label-primary title="#{stripe_contributions_pending.count} contribution(s) en attente - #{number_to_currency(stripe_contributions_pending.sum(:value), unit: '€', format: '%n %u')} brut" 💳 #{stripe_contributions_pending.count} en attente
                      - else
                        - if project.user.stripe_connect_account_id.present?
                          = link_to sync_stripe_account_project_path(project), method: :put, class: 'label label-warning', title: "Compte porteur: #{project.user.stripe_connect_account_id}\nCliquer pour synchroniser", data: { confirm: "Synchroniser ce projet avec le compte Stripe #{project.user.stripe_connect_account_id} ?" }
                            | 🔗 Synchroniser
                        - else
                          span.label ❌ Non activé
                  td
                    / - if project.user.kycs.other_documents.present?
                    /   - project.user.kycs.other_documents.each do |kyc|
                    /     = link_to kyc.uploaded_image.url do
                    /       i.icon-et-vcard[style="color:green"]
                    - if project.user.kycs_updatable_elements.present?
                      - project.user.kycs_updatable_elements.each do |kyc|
                        = link_to kyc.uploaded_image.url do
                          i.icon-et-vcard[style="color:green"]
                  td
                    .dropdown
                      = link_to 'javascript:void(0);', class: 'button tiny secondary dropdown-toggle', data: {dropdown: "dropdown-#{project.id}", toggle: "dropdown"} do
                        i.icon-et-down-dir
                      ul[id="dropdown-#{project.id}" data-dropdown-content class="dropdown-menu"]
                        li
                          = link_to populate_contribution_project_path(project) do
                            = t('.populate_contribution')
                        - if project.can_approve?
                          li
                            = link_to approve_project_path(project), method: :put  do
                              = t('.approve')

                        - if project.can_launch?
                          li
                            = link_to launch_project_path(project), method: :put do
                              = t('.launch')

                        - if project.can_reject?
                          li
                            = link_to reject_project_path(project), method: :put  do
                              = t('.reject')

                        /= MangoPay désactivé - Stripe Connect utilisé pour les transferts
                        /- if project.waiting_funds?
                        /  li
                        /    = link_to neighborly_mangopay.payout_project_path(project), method: :put  do
                        /      =t('.payout')

                        - if project.can_push_to_draft?
                          li
                            = link_to push_to_draft_project_path(project), method: :put  do
                              = t('.send_to_draft')

                        - if project.can_cancel?
                        /  li
                        /    = link_to cancel_project_path(project), method: :put  do
                        /      = t('.cancel')

                        /- if project.can_push_to_request_funds?
                        /  li
                        /    = link_to push_to_request_funds_project_path(project), method: :put do
                        /      = t('.request_funds')

                        /- if project.can_push_to_paid?
                        /  li
                        /    = link_to push_to_paid_project_path(project), method: :put do
                        /      = t('.paid') 

                        - if project.can_push_to_trash?
                          li
                            = link_to project_path(project), method: :delete, data: {confirm: t('neighborly.admin.confirm_dialog')} do
                              = t('.send_to_trash')

                        - if project.show_on_homepage
                          li
                            = link_to main_app.remove_project_on_homepage_project_path(project), method: :put do
                              = "Retirer de la page d'accueil"
                        - elsif project.recommended && !project.show_on_homepage
                          li
                            = link_to main_app.show_project_on_homepage_project_path(project), method: :put do
                              = "Mettre en page d'accueil"
                        
                        /= === OPTIONS STRIPE ===
                        li.divider
                        - if project.respond_to?(:use_stripe?)
                          li
                            - payout_profile_url = main_app.payout_profile_project_path(project)
                            - payout_unlock_url = main_app.unlock_payout_profile_edit_project_path(project)
                            - payout_edit_url = main_app.pay_project_path(project)
                            = link_to "javascript:openPayoutProfileModal('#{j(project.name)}', '#{payout_profile_url}', '#{payout_unlock_url}', '#{payout_edit_url}')" do
                              i.icon-et-vcard
                              = " 👤 Voir profil de retrait"

                          - unless project.use_stripe?
                            /= Activer Stripe (crée ou réutilise le compte du porteur)
                            li
                              = link_to main_app.enable_stripe_project_path(project), method: :put do
                                i.icon-et-credit-card
                                = " Activer Stripe"
                          - else
                            /= Contributions Stripe NON TRAITÉES (ni transférées, ni remboursées)
                            - stripe_contribs_pending = project.contributions.where(payment_method: 'Stripe', state: 'confirmed').where(stripe_refunded: [false, nil]).where(stripe_transferred: [false, nil])
                            - has_pending_contributions = stripe_contribs_pending.any?
                            - total_brut = stripe_contribs_pending.sum(:value)
                            /= Commission plateforme configurable via ENV ou 5% par défaut
                            - platform_fee_pct = ENV.fetch('PLATFORM_FEE', '5').tr(',', '.').to_f
                            /= PLATFORM_FEE est le % TOTAL annoncé au porteur (INCLUT frais Stripe)
                            /= Porteur reçoit: brut * (1 - PLATFORM_FEE%). Ex: 100€ * (1-4%) = 96€
                            - fiatope_commission = total_brut * (platform_fee_pct / 100.0)
                            - net_to_owner = total_brut - fiatope_commission
                            /= Frais Stripe estimés (info interne - inclus dans la commission)
                            - stripe_fees_estimate = stripe_contribs_pending.count * 0.25 + total_brut * 0.029
                            
                            /= Toutes les contributions Stripe confirmées (pour les modals avec filtre)
                            - all_stripe_contribs = project.contributions.where(payment_method: 'Stripe', state: ['confirmed', 'refunded'])
                            - build_contrib_data = lambda { |c| status = c.stripe_transferred ? 'transferred' : (c.stripe_refunded ? 'refunded' : 'pending'); { id: c.id, user_id: c.user_id, name: c.user&.name || 'Anonyme', email: c.user&.email || '', amount: c.value.to_f, charge_id: c.stripe_charge_id, date: (c.confirmed_at || c.created_at)&.strftime('%d/%m/%Y %H:%M'), stripe_fee: (c.value.to_f * 0.029 + 0.25).round(2), status: status, transfer_id: c.stripe_transfer_id, refund_id: c.stripe_refund_id } }
                            
                            /= TRANSFERT: si contributions EN ATTENTE + profil de retrait local complet
                            - can_transfer = has_pending_contributions && project.user.payout_profile_complete?
                            - if can_transfer
                              li
                                - transfer_url = main_app.process_stripe_transfer_project_path(project)
                                - stripe_acct = project.stripe_account_id.presence || project.user.stripe_connect_account_id
                                - transfer_contribs_list = all_stripe_contribs.map(&build_contrib_data)
                                - transfer_contribs_json = transfer_contribs_list.to_json.gsub("'", "\\\\'")
                                = link_to "javascript:openTransferModal('#{j(project.name)}', '#{j(project.user.name)}', '#{stripe_acct}', '#{sprintf('%.2f', total_brut)}', '#{sprintf('%.2f', stripe_fees_estimate)}', '#{sprintf('%.2f', fiatope_commission)}', '#{platform_fee_pct}', '#{sprintf('%.2f', net_to_owner)}', '#{transfer_url}', #{transfer_contribs_json})" do
                                  i.icon-et-money
                                  = " 💰 Transférer (~#{number_to_currency(net_to_owner, unit: '€', format: '%n %u')} net)"
                            
                            /= REMBOURSEMENT: si contributions EN ATTENTE (non encore remboursées/transférées)
                            - can_refund = has_pending_contributions
                            - if can_refund
                              li
                                - refund_url = main_app.process_stripe_refund_project_path(project)
                                - contributors_count = stripe_contribs_pending.count
                                - contributors_list = all_stripe_contribs.map(&build_contrib_data)
                                - contributors_json = contributors_list.to_json.gsub("'", "\\\\'")
                                = link_to "javascript:openRefundModal('#{j(project.name)}', '#{j(project.user.name)}', #{contributors_count}, '#{sprintf('%.2f', total_brut)}', '#{sprintf('%.2f', stripe_fees_estimate)}', '#{sprintf('%.2f', fiatope_commission)}', '#{platform_fee_pct}', #{contributors_json}, '#{refund_url}')" do
                                  i.icon-et-undo
                                  = " ↩️ Rembourser (#{contributors_count} contrib.)"
                            
                            /= VÉRIFICATION WALLET: réconciliation DB vs Stripe
                            - if project.stripe_wallet_balance > 0
                              li
                                = link_to main_app.verify_stripe_wallet_project_path(project), method: :get, data: { confirm: "Vérifier le wallet de #{project.name} via Stripe API ? (peut prendre quelques secondes)" } do
                                  i.icon-et-search
                                  = " 🔍 Vérifier Wallet"
                              
        = paginate @projects

/= Modals Stripe pour transfert et remboursement (UI professionnelle)
= render 'neighborly/admin/projects/stripe_modals'
