          $(this).show().css('opacity', '0.6').addClass('text-muted');
        } else {
          $(this).hide();
        }
      }
    });
  }
  
  // Modal transfert (avec détail des contributions + filtre traité/non-traité)
  function openTransferModal(projectName, ownerName, stripeAccount, grossAmount, stripeFees, platformFee, platformFeePct, netAmount, transferUrl, contributions) {
    $('#transferProjectName').text(projectName);
    $('#transferOwnerName').text(ownerName);
    $('#transferStripeAccount').html('<code>' + stripeAccount + '</code>');
    $('#transferGrossAmount').text(grossAmount + ' €');
    $('#transferStripeFees').text('-' + stripeFees + ' €');
    $('#transferPlatformFee').text('-' + platformFee + ' €');
    $('#transferPlatformFeePct').text(platformFeePct + '%');
    $('#transferNetAmount').text(netAmount + ' €');
    $('#transferForm').attr('action', transferUrl);
    
    // Calcul gain net plateforme = commission - frais Stripe
    var platformNetRevenue = (parseFloat(platformFee) || 0) - (parseFloat(stripeFees) || 0);
    $('#transferPlatformNetRevenue').text(platformNetRevenue.toFixed(2) + ' €');
    
    var tbody = $('#transferContributionsList');
    tbody.empty();
    var pendingCount = 0;
    var treatedCount = 0;
    
    if (contributions && contributions.length > 0) {
      contributions.forEach(function(c) {
        var isPending = (!c.status || c.status === 'pending');
        if (isPending) pendingCount++;
        else treatedCount++;
        var stripeFee = c.stripe_fee ? parseFloat(c.stripe_fee).toFixed(2) : (parseFloat(c.amount) * 0.029 + 0.25).toFixed(2);
        
        var row = $('<tr></tr>').attr('data-status', c.status || 'pending');
        if (!isPending) {
          row.addClass('text-muted').css('opacity', '0.6').hide();
        }
        
        row.append('<td>' + c.id + '</td>');
        row.append('<td>' + profileLink(c.user_id, c.name) + '</td>');
        row.append('<td class="text-right">' + parseFloat(c.amount).toFixed(2) + ' €</td>');
        row.append('<td class="text-right text-danger">' + stripeFee + ' €</td>');
        row.append('<td class="text-center">' + stripeRateDisplay(c.amount) + '</td>');
        row.append('<td>' + stripeChargeLink(c.charge_id) + '</td>');
        row.append('<td>' + statusBadge(c.status || 'pending') + '</td>');
        if (c.transfer_id) {
          row.append('<td><small class="text-success" title="' + c.transfer_id + '"><i class="fa fa-check"></i> ' + c.transfer_id.substring(0, 12) + '...</small></td>');
        } else {
          row.append('<td><small>' + (c.date || '—') + '</small></td>');
        }
        tbody.append(row);
      });
    } else {
      tbody.html('<tr><td colspan="8" class="text-center text-muted">Aucune contribution</td></tr>');
    }
    
    $('#transferPendingCount').text(pendingCount);
    // Afficher le compteur traité s'il y en a
    if (treatedCount > 0) {
      $('#transferTreatedInfo').html('<span class="badge badge-success ml-2">' + treatedCount + ' déjà transféré(s)</span>').show();
    } else {
      $('#transferTreatedInfo').hide();
    }
    
    document.getElementById('toggleTreatedTransfer').checked = false;
    document.getElementById('confirmTransferCheck').checked = false;
    document.getElementById('confirmTransferBtn').disabled = true;
    $('#confirmTransferBtn').html('<i class="fa fa-check mr-1"></i> Confirmer');
    $('#stripeTransferModal').modal('show');
  }
  
  // Modal remboursement avec checkboxes, filtre traité/non-traité, charge Stripe
  function openRefundModal(projectName, ownerName, contributorsCount, grossAmount, stripeFees, platformFee, platformFeePct, contributors, refundUrl) {
    refundContributorsData = contributors || [];
    platformFeePercent = parseFloat(platformFeePct) / 100;
    
    $('#refundProjectName').text(projectName);
    $('#refundOwnerName').text(ownerName);
    $('#refundContributorsCount').text(contributorsCount);
    $('#refundGrossAmount').text(grossAmount + ' €');
    $('#refundStripeFees').text('-' + stripeFees + ' €');
    $('#refundPlatformFee').text('-' + platformFee + ' €');
    $('#refundPlatformFeePct').text(platformFeePct + '%');
    
    var gross = parseFloat(grossAmount) || 0;
    var sFees = parseFloat(stripeFees) || 0;
    var pFee = parseFloat(platformFee) || 0;
    var netTotal = gross - sFees - pFee;
    $('#refundNetAmount').text(netTotal.toFixed(2) + ' €');
    
    var tbody = $('#refundContributorsList');
    tbody.empty();
    var pendingCount = 0;
    
    if (contributors && contributors.length > 0) {
      contributors.forEach(function(c) {
        var isPending = (!c.status || c.status === 'pending');
        if (isPending) pendingCount++;
        var paid = parseFloat(c.amount);
        var stripePerTxn = c.stripe_fee ? parseFloat(c.stripe_fee) : (paid * 0.029 + 0.25);
        var platformPerTxn = paid * platformFeePercent;
        var refunded = paid - stripePerTxn - platformPerTxn;
        if (refunded < 0) refunded = 0;
        
        var row = $('<tr></tr>');
        row.attr('data-status', c.status || 'pending');
        
        if (isPending) {
          row.append('<td class="text-center"><input type="checkbox" class="contribution-checkbox" data-contribution-id="' + c.id + '" onchange="updateSelectedSummary()" style="width: 16px; height: 16px;"></td>');
        } else {
          // Lignes traitées: pas de checkbox, grisées, masquées par défaut
          row.addClass('text-muted').css('opacity', '0.6').hide();
          row.append('<td class="text-center"><i class="fa fa-ban text-muted" title="Déjà traitée"></i></td>');
        }
        
        row.append('<td>' + profileLink(c.user_id, c.name) + '<br><small class="text-muted">' + (c.email || '') + '</small></td>');
        row.append('<td class="text-right">' + paid.toFixed(2) + ' €</td>');
        row.append('<td class="text-right text-danger">' + stripePerTxn.toFixed(2) + ' €</td>');
        row.append('<td class="text-center">' + stripeRateDisplay(paid) + '</td>');
        row.append('<td class="text-right text-warning">' + platformPerTxn.toFixed(2) + ' €</td>');
        row.append('<td class="text-right text-success font-weight-bold">' + refunded.toFixed(2) + ' €</td>');
        row.append('<td>' + stripeChargeLink(c.charge_id) + '</td>');
        row.append('<td>' + statusBadge(c.status || 'pending') + '</td>');
        row.append('<td><small>' + (c.date || '—') + '</small></td>');
        tbody.append(row);
      });
    } else {
      tbody.html('<tr><td colspan="10" class="text-center text-muted">Aucun contributeur</td></tr>');
    }
    
    $('#refundPendingCount').text(pendingCount);
    $('#refundForm').attr('action', refundUrl);
    document.getElementById('toggleTreatedRefund').checked = false;
    document.getElementById('confirmRefundCheck').checked = false;
    document.getElementById('selectAllContributions').checked = false;
    document.getElementById('confirmRefundBtn').disabled = true;
    $('#selectedContributionIds').val('');
    $('#selectedCount').text('0 contribution(s) sélectionnée(s)');
    $('#selectedTotal').text('0.00 €');
    $('#confirmRefundBtn').html('<i class="fa fa-undo mr-1"></i> Confirmer');
    $('#stripeRefundModal').modal('show');
  }
  
  // Version simple
  function openRefundModalSimple(projectName, ownerName, contributorsCount, totalAmount, refundUrl) {
    openRefundModal(projectName, ownerName, contributorsCount, totalAmount, '0.00', '0.00', '0', [], refundUrl);
  }
