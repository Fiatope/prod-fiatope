/= Modals Stripe - Fiatope

/= Modal de confirmation de transfert
#stripeTransferModal.modal.fade[tabindex="-1" role="dialog"]
  .modal-dialog.modal-lg[role="document"]
    .modal-content
      .modal-header.bg-success.text-white
        h5.modal-title
          i.fa.fa-exchange.mr-2
          | Transfert des fonds
        button.close.text-white[type="button" data-dismiss="modal" aria-label="Fermer"]
          span[aria-hidden="true"] &times;
      .modal-body
        .alert.alert-warning.mb-3
          i.fa.fa-exclamation-triangle.mr-2
          strong Action irréversible.
          |  Les fonds seront transférés définitivement.
        
        table.table.table-bordered.table-sm
          tbody
            tr
              td.font-weight-bold[style="width: 50%;"] Projet
              td#transferProjectName
            tr
              td.font-weight-bold Porteur
              td#transferOwnerName
            tr
              td.font-weight-bold Compte Stripe
              td#transferStripeAccount
            tr
              td.font-weight-bold Montant brut collecté
              td#transferGrossAmount
            tr
              td
                | Frais Stripe
                small.text-muted.ml-1
                  |  (2.9% + 0.25€/txn)
              td.text-danger#transferStripeFees
            tr
              td
                | Commission Fiatope
                span.badge.badge-warning.ml-1#transferPlatformFeePct
              td.text-warning#transferPlatformFee
            tr.table-success
              td.font-weight-bold Montant NET pour le porteur
              td.font-weight-bold#transferNetAmount
        
        .p-3.bg-light.border.rounded.mt-3
          label.d-flex.align-items-center.mb-0[style="cursor: pointer;"]
            input#confirmTransferCheck[type="checkbox" onclick="toggleTransferBtn()" style="width: 18px; height: 18px; margin-right: 10px;"]
            span.font-weight-bold Je confirme vouloir transférer les fonds
      
      .modal-footer
        button.btn.btn-secondary[type="button" data-dismiss="modal"] Annuler
        form#transferForm.d-inline[method="post"]
          input[type="hidden" name="_method" value="put"]
          input[type="hidden" name="authenticity_token" value=""]
          button#confirmTransferBtn.btn.btn-success[type="submit" disabled="disabled"]
            i.fa.fa-check.mr-1
            | Confirmer

/= Modal de confirmation de remboursement
#stripeRefundModal.modal.fade[tabindex="-1" role="dialog"]
  .modal-dialog.modal-lg[role="document"]
    .modal-content
      .modal-header.bg-danger.text-white
        h5.modal-title
          i.fa.fa-undo.mr-2
          | Remboursement des contributeurs
        button.close.text-white[type="button" data-dismiss="modal" aria-label="Fermer"]
          span[aria-hidden="true"] &times;
      .modal-body
        .alert.alert-danger.mb-3
          i.fa.fa-exclamation-circle.mr-2
          strong Attention.
          |  Les frais Stripe et la commission seront déduits.
        
        table.table.table-bordered.table-sm
          tbody
            tr
              td.font-weight-bold[style="width: 50%;"] Projet
              td#refundProjectName
            tr
              td.font-weight-bold Porteur
              td#refundOwnerName
            tr
              td.font-weight-bold Contributeurs
              td#refundContributorsCount
            tr
              td.font-weight-bold Total collecté
              td#refundGrossAmount
            tr
              td
                | Frais Stripe retenus
                small.text-muted.ml-1
                  |  (2.9% + 0.25€/txn)
              td.text-danger#refundStripeFees
            tr
              td
                | Commission Fiatope retenue
                span.badge.badge-secondary.ml-1#refundPlatformFeePct
              td.text-warning#refundPlatformFee
            tr.table-info
              td.font-weight-bold Total remboursé aux contributeurs
              td.font-weight-bold#refundNetAmount
        
        .card.mt-3
          .card-header.bg-light.py-2.d-flex.justify-content-between.align-items-center
            span
              i.fa.fa-users.mr-2
              strong Sélectionnez les contributions à rembourser
            label.mb-0.d-flex.align-items-center[style="cursor: pointer;"]
              input#selectAllContributions[type="checkbox" onclick="toggleSelectAll()" style="width: 16px; height: 16px; margin-right: 6px;"]
              span.small Tout sélectionner
          .card-body.p-0[style="max-height: 200px; overflow-y: auto;"]
            table.table.table-sm.table-striped.mb-0
              thead.thead-light
                tr
                  th.text-center[style="width: 40px;"]
                    i.fa.fa-check-square
                  th Contributeur
                  th.text-right Payé
                  th.text-right.text-danger Retenu
                  th.text-right.text-success Remboursé
              tbody#refundContributorsList
                tr
                  td.text-center.text-muted[colspan="5"] Chargement...
          .card-footer.bg-light.py-2
            .d-flex.justify-content-between.align-items-center
              span#selectedCount.small.text-muted 0 contribution(s) sélectionnée(s)
              span#selectedTotal.font-weight-bold.text-success 0.00 €
        
        .p-3.bg-light.border.rounded.mt-3
          label.d-flex.align-items-center.mb-0[style="cursor: pointer;"]
            input#confirmRefundCheck[type="checkbox" onclick="toggleRefundBtn()" style="width: 18px; height: 18px; margin-right: 10px;"]
            span.font-weight-bold Je confirme vouloir rembourser les contributeurs
      
      .modal-footer
        button.btn.btn-secondary[type="button" data-dismiss="modal"] Annuler
        form#refundForm.d-inline[method="post"]
          input[type="hidden" name="_method" value="put"]
          input[type="hidden" name="authenticity_token" value=""]
          input#selectedContributionIds[type="hidden" name="contribution_ids" value=""]
          button#confirmRefundBtn.btn.btn-danger[type="submit" disabled="disabled"]
            i.fa.fa-undo.mr-1
            | Confirmer

javascript:
  // Variables globales pour la modal de remboursement
  var refundContributorsData = [];
  var platformFeePercent = 0;
  
  // Fonctions globales pour toggle des boutons
  function toggleTransferBtn() {
    var cb = document.getElementById('confirmTransferCheck');
    var btn = document.getElementById('confirmTransferBtn');
    btn.disabled = !cb.checked;
  }
  
  function toggleRefundBtn() {
    var cb = document.getElementById('confirmRefundCheck');
    var btn = document.getElementById('confirmRefundBtn');
    var selectedIds = getSelectedContributionIds();
    // Activer seulement si confirmé ET au moins une contribution sélectionnée
    btn.disabled = !(cb.checked && selectedIds.length > 0);
  }
  
  // Sélectionner/Désélectionner tous les contributeurs
  function toggleSelectAll() {
    var selectAllCb = document.getElementById('selectAllContributions');
    var checkboxes = document.querySelectorAll('.contribution-checkbox');
    checkboxes.forEach(function(cb) {
      cb.checked = selectAllCb.checked;
    });
    updateSelectedSummary();
    toggleRefundBtn();
  }
  
  // Mettre à jour le résumé des sélections
  function updateSelectedSummary() {
    var checkboxes = document.querySelectorAll('.contribution-checkbox:checked');
    var count = checkboxes.length;
    var total = 0;
    
    checkboxes.forEach(function(cb) {
      var contribId = cb.dataset.contributionId;
      var contrib = refundContributorsData.find(function(c) { return c.id == contribId; });
      if (contrib) {
        var paid = parseFloat(contrib.amount);
        var stripePerTxn = paid * 0.029 + 0.25;
        var platformPerTxn = paid * platformFeePercent;
        var refunded = paid - stripePerTxn - platformPerTxn;
        if (refunded < 0) refunded = 0;
        total += refunded;
      }
    });
    
    $('#selectedCount').text(count + ' contribution(s) sélectionnée(s)');
    $('#selectedTotal').text(total.toFixed(2) + ' €');
    
    // Mettre à jour le champ hidden avec les IDs sélectionnés
    $('#selectedContributionIds').val(getSelectedContributionIds().join(','));
    
    // Mettre à jour l'état du "Select All"
    var allCheckboxes = document.querySelectorAll('.contribution-checkbox');
    document.getElementById('selectAllContributions').checked = (count === allCheckboxes.length && count > 0);
    
    toggleRefundBtn();
  }
  
  // Récupérer les IDs des contributions sélectionnées
  function getSelectedContributionIds() {
    var ids = [];
    document.querySelectorAll('.contribution-checkbox:checked').forEach(function(cb) {
      ids.push(cb.dataset.contributionId);
    });
    return ids;
  }
  
  $(document).ready(function() {
    var csrfToken = $('meta[name="csrf-token"]').attr('content');
    $('#transferForm input[name="authenticity_token"]').val(csrfToken);
    $('#refundForm input[name="authenticity_token"]').val(csrfToken);
    
    $('#stripeTransferModal, #stripeRefundModal').on('hidden.bs.modal', function() {
      $(this).find('input[type="checkbox"]').prop('checked', false);
      $(this).find('button[type="submit"]').prop('disabled', true);
    });
    
    $('#transferForm').on('submit', function() {
      $('#confirmTransferBtn').prop('disabled', true).html('<i class="fa fa-spinner fa-spin mr-1"></i> En cours...');
    });
    
    $('#refundForm').on('submit', function() {
      $('#confirmRefundBtn').prop('disabled', true).html('<i class="fa fa-spinner fa-spin mr-1"></i> En cours...');
    });
  });
  
  // Modal transfert
  function openTransferModal(projectName, ownerName, stripeAccount, grossAmount, stripeFees, platformFee, platformFeePct, netAmount, transferUrl) {
    $('#transferProjectName').text(projectName);
    $('#transferOwnerName').text(ownerName);
    $('#transferStripeAccount').html('<code>' + stripeAccount + '</code>');
    $('#transferGrossAmount').text(grossAmount + ' €');
    $('#transferStripeFees').text('-' + stripeFees + ' €');
    $('#transferPlatformFee').text('-' + platformFee + ' €');
    $('#transferPlatformFeePct').text(platformFeePct + '%');
    $('#transferNetAmount').text(netAmount + ' €');
    $('#transferForm').attr('action', transferUrl);
    document.getElementById('confirmTransferCheck').checked = false;
    document.getElementById('confirmTransferBtn').disabled = true;
    $('#confirmTransferBtn').html('<i class="fa fa-check mr-1"></i> Confirmer');
    $('#stripeTransferModal').modal('show');
  }
  
  // Modal remboursement avec checkboxes pour sélection individuelle
  // contributors doit contenir: id, name, email, amount
  function openRefundModal(projectName, ownerName, contributorsCount, grossAmount, stripeFees, platformFee, platformFeePct, contributors, refundUrl) {
    // Stocker les données pour les calculs
    refundContributorsData = contributors || [];
    platformFeePercent = parseFloat(platformFeePct) / 100;
    
    $('#refundProjectName').text(projectName);
    $('#refundOwnerName').text(ownerName);
    $('#refundContributorsCount').text(contributorsCount);
    $('#refundGrossAmount').text(grossAmount + ' €');
    $('#refundStripeFees').text('-' + stripeFees + ' €');
    $('#refundPlatformFee').text('-' + platformFee + ' €');
    $('#refundPlatformFeePct').text(platformFeePct + '%');
    
    // Calcul du net total remboursé
    var gross = parseFloat(grossAmount) || 0;
    var sFees = parseFloat(stripeFees) || 0;
    var pFee = parseFloat(platformFee) || 0;
    var netTotal = gross - sFees - pFee;
    $('#refundNetAmount').text(netTotal.toFixed(2) + ' €');
    
    // Remplir liste des contributeurs avec checkboxes
    var tbody = $('#refundContributorsList');
    tbody.empty();
    
    if (contributors && contributors.length > 0) {
      contributors.forEach(function(c) {
        var paid = parseFloat(c.amount);
        // Frais Stripe par transaction: 2.9% + 0.25€
        var stripePerTxn = paid * 0.029 + 0.25;
        // Commission plateforme sur ce montant
        var platformPerTxn = paid * platformFeePercent;
        // Total retenu
        var retained = stripePerTxn + platformPerTxn;
        // Montant remboursé
        var refunded = paid - retained;
        if (refunded < 0) refunded = 0;
        
        var row = $('<tr></tr>');
        row.append('<td class="text-center"><input type="checkbox" class="contribution-checkbox" data-contribution-id="' + c.id + '" onchange="updateSelectedSummary()" style="width: 16px; height: 16px;"></td>');
        row.append('<td>' + c.name + '<br><small class="text-muted">' + (c.email || '') + '</small></td>');
        row.append('<td class="text-right">' + paid.toFixed(2) + ' €</td>');
        row.append('<td class="text-right text-danger">' + retained.toFixed(2) + ' €</td>');
        row.append('<td class="text-right text-success font-weight-bold">' + refunded.toFixed(2) + ' €</td>');
        tbody.append(row);
      });
    } else {
      tbody.html('<tr><td colspan="5" class="text-center text-muted">Aucun contributeur</td></tr>');
    }
    
    $('#refundForm').attr('action', refundUrl);
    document.getElementById('confirmRefundCheck').checked = false;
    document.getElementById('selectAllContributions').checked = false;
    document.getElementById('confirmRefundBtn').disabled = true;
    $('#selectedContributionIds').val('');
    $('#selectedCount').text('0 contribution(s) sélectionnée(s)');
    $('#selectedTotal').text('0.00 €');
    $('#confirmRefundBtn').html('<i class="fa fa-undo mr-1"></i> Confirmer');
    $('#stripeRefundModal').modal('show');
  }
  
  // Version simple
  function openRefundModalSimple(projectName, ownerName, contributorsCount, totalAmount, refundUrl) {
    openRefundModal(projectName, ownerName, contributorsCount, totalAmount, '0.00', '0.00', '0', [], refundUrl);
  }
