/= Modals Stripe - Fiatope

/= Modal de confirmation de transfert
#stripeTransferModal.modal.fade[tabindex="-1" role="dialog"]
  .modal-dialog.modal-lg[role="document"]
    .modal-content
      .modal-header.bg-success.text-white
        h5.modal-title
          i.fa.fa-exchange.mr-2
          | Transfert des fonds
        button.close.text-white[type="button" data-dismiss="modal" aria-label="Fermer"]
          span[aria-hidden="true"] &times;
      .modal-body
        .alert.alert-warning.mb-3
          i.fa.fa-exclamation-triangle.mr-2
          strong Action irréversible.
          |  Les fonds seront transférés définitivement.
        
        table.table.table-bordered.table-sm
          tbody
            tr
              td.font-weight-bold[style="width: 50%;"] Projet
              td#transferProjectName
            tr
              td.font-weight-bold Porteur
              td#transferOwnerName
            tr
              td.font-weight-bold Compte Stripe
              td#transferStripeAccount
            tr
              td.font-weight-bold Montant brut collecté
              td#transferGrossAmount
            tr
              td
                | Frais Stripe
                small.text-muted.ml-1
                  |  (2.9% + 0.25€/txn)
              td.text-danger#transferStripeFees
            tr
              td
                | Commission Fiatope
                span.badge.badge-warning.ml-1#transferPlatformFeePct
              td.text-warning#transferPlatformFee
            tr.table-success
              td.font-weight-bold Montant NET pour le porteur
              td.font-weight-bold#transferNetAmount
            tr
              td
                i.fa.fa-building.mr-1.text-info
                | Gain net plateforme
                small.text-muted.ml-1  (commission - frais Stripe)
              td.text-info.font-weight-bold#transferPlatformNetRevenue
        
        .card.mt-3
          .card-header.bg-light.py-2.d-flex.justify-content-between.align-items-center
            span
              i.fa.fa-list.mr-2
              strong Détail des contributions
              span.badge.badge-info.ml-2#transferPendingCount 0
              span.small.text-muted.ml-1 en attente
              span#transferTreatedInfo
            .d-flex.align-items-center
              label.mb-0.d-flex.align-items-center.small[style="cursor:pointer;"]
                input#toggleTreatedTransfer[type="checkbox" onchange="filterTransferRows()" style="width:14px;height:14px;margin-right:5px;"]
                span.text-muted Afficher traitées
          .card-body.p-0[style="max-height: 300px; overflow-y: auto;"]
            table.table.table-sm.table-striped.mb-0
              thead.thead-light
                tr
                  th # ID
                  th Contributeur
                  th.text-right Montant
                  th.text-right.text-danger Frais Stripe
                  th.text-center Taux
                  th Charge Stripe
                  th Statut
                  th Date
              tbody#transferContributionsList
                tr
                  td.text-center.text-muted[colspan="8"] Chargement...
        
        .p-3.bg-light.border.rounded.mt-3
          label.d-flex.align-items-center.mb-0[style="cursor: pointer;"]
            input#confirmTransferCheck[type="checkbox" onclick="toggleTransferBtn()" style="width: 18px; height: 18px; margin-right: 10px;"]
            span.font-weight-bold Je confirme vouloir transférer les fonds
      
      .modal-footer
        button.btn.btn-secondary[type="button" data-dismiss="modal"] Annuler
        form#transferForm.d-inline[method="post"]
          input[type="hidden" name="_method" value="put"]
          input[type="hidden" name="authenticity_token" value=""]
          button#confirmTransferBtn.btn.btn-success[type="submit" disabled="disabled"]
            i.fa.fa-check.mr-1
            | Confirmer

/= Modal de confirmation de remboursement
#stripeRefundModal.modal.fade[tabindex="-1" role="dialog"]
  .modal-dialog.modal-lg[role="document"]
    .modal-content
      .modal-header.bg-danger.text-white
        h5.modal-title
          i.fa.fa-undo.mr-2
          | Remboursement des contributeurs
        button.close.text-white[type="button" data-dismiss="modal" aria-label="Fermer"]
          span[aria-hidden="true"] &times;
      .modal-body
        .alert.alert-danger.mb-3
          i.fa.fa-exclamation-circle.mr-2
          strong Attention.
          |  Les frais Stripe et la commission seront déduits.
        
        table.table.table-bordered.table-sm
          tbody
            tr
              td.font-weight-bold[style="width: 50%;"] Projet
              td#refundProjectName
            tr
              td.font-weight-bold Porteur
              td#refundOwnerName
            tr
              td.font-weight-bold Contributeurs
              td#refundContributorsCount
            tr
              td.font-weight-bold Total collecté
              td#refundGrossAmount
            tr
              td
                | Frais Stripe retenus
                small.text-muted.ml-1
                  |  (2.9% + 0.25€/txn)
              td.text-danger#refundStripeFees
            tr
              td
                | Commission Fiatope retenue
                span.badge.badge-secondary.ml-1#refundPlatformFeePct
              td.text-warning#refundPlatformFee
            tr.table-info
              td.font-weight-bold Total remboursé aux contributeurs
              td.font-weight-bold#refundNetAmount
        
        .card.mt-3
          .card-header.bg-light.py-2
            .d-flex.justify-content-between.align-items-center
              span
                i.fa.fa-users.mr-2
                strong Contributions
                span.badge.badge-info.ml-2#refundPendingCount 0
                span.small.text-muted.ml-1 remboursables
              .d-flex.align-items-center
                label.mb-0.d-flex.align-items-center.small.mr-3[style="cursor:pointer;"]
                  input#toggleTreatedRefund[type="checkbox" onchange="filterRefundRows()" style="width:14px;height:14px;margin-right:5px;"]
                  span.text-muted Afficher traitées
                label.mb-0.d-flex.align-items-center[style="cursor: pointer;"]
                  input#selectAllContributions[type="checkbox" onclick="toggleSelectAll()" style="width: 16px; height: 16px; margin-right: 6px;"]
                  span.small Tout sélectionner
          .card-body.p-0[style="max-height: 300px; overflow-y: auto;"]
            table.table.table-sm.table-striped.mb-0
              thead.thead-light
                tr
                  th.text-center[style="width: 40px;"]
                    i.fa.fa-check-square
                  th Contributeur
                  th.text-right Payé
                  th.text-right.text-danger Frais Stripe
                  th.text-center Taux
                  th.text-right.text-warning Commission
                  th.text-right.text-success Remboursé
                  th Charge Stripe
                  th Statut
                  th Date
              tbody#refundContributorsList
                tr
                  td.text-center.text-muted[colspan="10"] Chargement...
          .card-footer.bg-light.py-2
            .d-flex.justify-content-between.align-items-center
              span#selectedCount.small.text-muted 0 contribution(s) sélectionnée(s)
              span#selectedTotal.font-weight-bold.text-success 0.00 €
        
        .p-3.bg-light.border.rounded.mt-3
          label.d-flex.align-items-center.mb-0[style="cursor: pointer;"]
            input#confirmRefundCheck[type="checkbox" onclick="toggleRefundBtn()" style="width: 18px; height: 18px; margin-right: 10px;"]
            span.font-weight-bold Je confirme vouloir rembourser les contributeurs
      
      .modal-footer
        button.btn.btn-secondary[type="button" data-dismiss="modal"] Annuler
        form#refundForm.d-inline[method="post"]
          input[type="hidden" name="_method" value="put"]
          input[type="hidden" name="authenticity_token" value=""]
          input#selectedContributionIds[type="hidden" name="contribution_ids" value=""]
          button#confirmRefundBtn.btn.btn-danger[type="submit" disabled="disabled"]
            i.fa.fa-undo.mr-1
            | Confirmer

/= Modal profil de retrait (donnees locales)
#payoutProfileModal.modal.fade[tabindex="-1" role="dialog"]
  .modal-dialog.modal-lg[role="document"]
    .modal-content
      .modal-header.bg-info.text-white
        h5.modal-title
          i.fa.fa-id-card.mr-2
          | Profil de retrait du porteur
        button.close.text-white[type="button" data-dismiss="modal" aria-label="Fermer"]
          span[aria-hidden="true"] &times;
      .modal-body
        .alert#payoutProfileStatus.alert-info.mb-3
          i.fa.fa-info-circle.mr-2
          | Chargement...

