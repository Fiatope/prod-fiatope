                  td#payoutProfileProjectName
                tr
                  td.font-weight-bold Nom
                  td#payoutOwnerName
                tr
                  td.font-weight-bold Email
                  td#payoutOwnerEmail
                tr
                  td.font-weight-bold Type
                  td#payoutOwnerType
                tr
                  td.font-weight-bold Entreprise
                  td#payoutOwnerOrganization
                tr
                  td.font-weight-bold Date de naissance
                  td#payoutOwnerBirthday
                tr
                  td.font-weight-bold Nationalite
                  td#payoutOwnerNationality
                tr
                  td.font-weight-bold Pays de residence
                  td#payoutOwnerResidence
                tr
                  td.font-weight-bold Telephone
                  td#payoutOwnerPhone
                tr
                  td.font-weight-bold Compte Stripe
                  td#payoutOwnerStripeAccount

          .col-md-6
            h6
              i.fa.fa-university.mr-1
              | Banque
            table.table.table-sm.table-bordered
              tbody
                tr
                  td.font-weight-bold[style="width:45%;"] Adresse
                  td#payoutBankAddress
                tr
                  td.font-weight-bold Ville
                  td#payoutBankCity
                tr
                  td.font-weight-bold Region
                  td#payoutBankRegion
                tr
                  td.font-weight-bold Code postal
                  td#payoutBankPostal
                tr
                  td.font-weight-bold Pays
                  td#payoutBankCountry
                tr
                  td.font-weight-bold Type de reference
                  td#payoutBankReferenceType
                tr
                  td.font-weight-bold Reference bancaire
                  td#payoutBankReferenceValue

        .mt-3
          h6
            i.fa.fa-credit-card.mr-1
            | Verification Stripe
          .alert#payoutStripeStatus.alert-light[style="border:1px solid #dee2e6;"]
            | Chargement...
          ul#payoutStripeRequirements.list-group
            li.list-group-item.text-muted Chargement...

        .mt-3
          h6
            i.fa.fa-files-o.mr-1
            | Justificatifs
          ul#payoutKycList.list-group
            li.list-group-item.text-muted Chargement...

        .mt-3
          h6
            i.fa.fa-exclamation-triangle.mr-1
            | Champs manquants
          ul#payoutMissingList.list-group
            li.list-group-item.text-muted Chargement...

      .modal-footer
        button.btn.btn-secondary[type="button" data-dismiss="modal"] Fermer

#payoutDocumentViewerModal.modal.fade[tabindex="-1" role="dialog"]
  .modal-dialog.modal-xl[role="document"]
    .modal-content
      .modal-header
        h5.modal-title
          i.fa.fa-search-plus.mr-2
          | Visualisation du document
        button.close[type="button" data-dismiss="modal" aria-label="Fermer"]
          span[aria-hidden="true"] &times;
      .modal-body
        #payoutDocViewerStage.text-center[style="max-height:70vh;overflow:auto;background:#111;padding:10px;"]
          img#payoutDocViewerImage[alt="Document" style="display:block;max-width:100%;width:auto;height:auto;margin:0 auto;transition:width .15s ease;cursor:zoom-in;"]
      .modal-footer
        span.badge.badge-light.mr-auto#payoutDocZoomLabel 100%
        a#payoutDocOpenNewTab.btn.btn-outline-secondary[target="_blank" rel="noopener"]
          i.fa.fa-external-link.mr-1
          | Ouvrir dans un nouvel onglet
        button.btn.btn-outline-primary[type="button" onclick="payoutDocZoomOut()"]
          i.fa.fa-search-minus.mr-1
          | De-zoomer
        button.btn.btn-outline-primary[type="button" onclick="payoutDocZoomIn()"]
          i.fa.fa-search-plus.mr-1
          | Zoomer
        button.btn.btn-outline-secondary[type="button" onclick="payoutDocZoomReset()"]
          i.fa.fa-refresh.mr-1
          | Restaurer
        button.btn.btn-secondary[type="button" data-dismiss="modal"] Fermer

- stripe_test_mode = ENV.fetch('STRIPE_SECRET_KEY', 'sk_test_').start_with?('sk_test_')
javascript:
  // Mode test/prod Stripe pour adapter les URLs du dashboard
  var stripeTestMode = #{stripe_test_mode};
  var stripeDashboardBase = stripeTestMode ? 'https://dashboard.stripe.com/test/payments/' : 'https://dashboard.stripe.com/payments/';
  
  // Variables globales pour la modal de remboursement
  var refundContributorsData = [];
  var platformFeePercent = 0;
  var payoutDocViewerScale = 1;
  var payoutDocViewerUrl = null;
  var payoutProfileWasVisibleBeforeViewer = false;
  var payoutProfileUnlockUrl = null;
  var payoutProfileEditUrl = null;

  function escapeHtml(value) {
    if (value === null || value === undefined) return '';
    return String(value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/\"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function payoutDocApplyZoom() {
    var widthPercent = Math.max(100, Math.round(payoutDocViewerScale * 100));
    var cursor = payoutDocViewerScale > 1 ? 'zoom-out' : 'zoom-in';

    $('#payoutDocViewerImage').css({
      width: widthPercent + '%',
      maxWidth: 'none',
      cursor: cursor
    });
    $('#payoutDocZoomLabel').text(Math.round(payoutDocViewerScale * 100) + '%');
  }

  function showPayoutDocViewerModal() {
    $('#payoutDocumentViewerModal').modal('show');
  }

  function openPayoutDocViewer(url) {
    if (!url) return;
    payoutDocViewerScale = 1;
    payoutDocViewerUrl = url;
    $('#payoutDocViewerImage').attr('src', url);
    $('#payoutDocOpenNewTab').attr('href', url);
    payoutDocApplyZoom();
    $('#payoutDocViewerStage').scrollTop(0).scrollLeft(0);

    payoutProfileWasVisibleBeforeViewer = $('#payoutProfileModal').is(':visible');
    if (payoutProfileWasVisibleBeforeViewer) {
      $('#payoutProfileModal').one('hidden.bs.modal', function() {
        showPayoutDocViewerModal();
      }).modal('hide');
    } else {
      showPayoutDocViewerModal();
    }
  }

  function payoutDocZoomIn() {
    payoutDocViewerScale = Math.min(5, payoutDocViewerScale + 0.2);
    payoutDocApplyZoom();
  }

  function payoutDocZoomOut() {
    payoutDocViewerScale = Math.max(1, payoutDocViewerScale - 0.2);
    payoutDocApplyZoom();
  }

  function payoutDocZoomReset() {
    payoutDocViewerScale = 1;
    payoutDocApplyZoom();
  }
  
  // Fonctions globales pour toggle des boutons
  function toggleTransferBtn() {
    var cb = document.getElementById('confirmTransferCheck');
    var btn = document.getElementById('confirmTransferBtn');
    btn.disabled = !cb.checked;
  }
  
  function toggleRefundBtn() {
    var cb = document.getElementById('confirmRefundCheck');
    var btn = document.getElementById('confirmRefundBtn');
    var selectedIds = getSelectedContributionIds();
    // Activer seulement si confirmé ET au moins une contribution sélectionnée
    btn.disabled = !(cb.checked && selectedIds.length > 0);
  }
  
  // Sélectionner/Désélectionner tous les contributeurs
  function toggleSelectAll() {
    var selectAllCb = document.getElementById('selectAllContributions');
    var checkboxes = document.querySelectorAll('.contribution-checkbox');
    checkboxes.forEach(function(cb) {
      cb.checked = selectAllCb.checked;
    });
    updateSelectedSummary();
    toggleRefundBtn();
  }
  
  // Mettre à jour le résumé des sélections
  function updateSelectedSummary() {
    var checkboxes = document.querySelectorAll('.contribution-checkbox:checked');
    var count = checkboxes.length;
    var total = 0;
    
    checkboxes.forEach(function(cb) {
      var contribId = cb.dataset.contributionId;
      var contrib = refundContributorsData.find(function(c) { return c.id == contribId; });
      if (contrib) {
        var paid = parseFloat(contrib.amount);
        var stripePerTxn = contrib.stripe_fee ? parseFloat(contrib.stripe_fee) : (paid * 0.029 + 0.25);
        var platformPerTxn = paid * platformFeePercent;
        var refunded = paid - stripePerTxn - platformPerTxn;
        if (refunded < 0) refunded = 0;
        total += refunded;
      }
    });
    
    $('#selectedCount').text(count + ' contribution(s) sélectionnée(s)');
    $('#selectedTotal').text(total.toFixed(2) + ' €');
    
    // Mettre à jour le champ hidden avec les IDs sélectionnés
    $('#selectedContributionIds').val(getSelectedContributionIds().join(','));
    
    // Mettre à jour l'état du "Select All"
    var allCheckboxes = document.querySelectorAll('.contribution-checkbox');
    document.getElementById('selectAllContributions').checked = (count === allCheckboxes.length && count > 0);
    
    toggleRefundBtn();
  }
  
  // Récupérer les IDs des contributions sélectionnées
  function getSelectedContributionIds() {
    var ids = [];
    document.querySelectorAll('.contribution-checkbox:checked').forEach(function(cb) {
      ids.push(cb.dataset.contributionId);
    });
    return ids;
  }
  
  $(document).ready(function() {
    var csrfToken = $('meta[name="csrf-token"]').attr('content');
    $('#transferForm input[name="authenticity_token"]').val(csrfToken);
    $('#refundForm input[name="authenticity_token"]').val(csrfToken);
    
    $('#stripeTransferModal, #stripeRefundModal').on('hidden.bs.modal', function() {
      $(this).find('input[type="checkbox"]').prop('checked', false);
      $(this).find('button[type="submit"]').prop('disabled', true);
    });
    
    $('#transferForm').on('submit', function() {
      $('#confirmTransferBtn').prop('disabled', true).html('<i class="fa fa-spinner fa-spin mr-1"></i> En cours...');
    });
    
    $('#refundForm').on('submit', function() {
      $('#confirmRefundBtn').prop('disabled', true).html('<i class="fa fa-spinner fa-spin mr-1"></i> En cours...');
    });

    $(document).on('click', '.payout-doc-thumb', function() {
      openPayoutDocViewer($(this).data('fullUrl') || $(this).attr('src'));
    });

    $(document).on('click', '#payoutDocViewerImage', function() {
      if (payoutDocViewerScale > 1) {
        payoutDocZoomReset();
      } else {
        payoutDocViewerScale = 2;
        payoutDocApplyZoom();
      }
    });

    $(document).on('wheel', '#payoutDocViewerStage', function(event) {
      if (!$('#payoutDocumentViewerModal').hasClass('show')) {
        return;
      }

      event.preventDefault();
      var deltaY = event.originalEvent && event.originalEvent.deltaY ? event.originalEvent.deltaY : 0;
      if (deltaY < 0) {
        payoutDocZoomIn();
      } else if (deltaY > 0) {
        payoutDocZoomOut();
      }
    });

    $('#payoutDocumentViewerModal').on('hidden.bs.modal', function() {
      payoutDocZoomReset();
      $('#payoutDocViewerImage').attr('src', '');

      if (payoutProfileWasVisibleBeforeViewer) {
        payoutProfileWasVisibleBeforeViewer = false;
        $('#payoutProfileModal').modal('show');
      }
    });
  });
  
  // Génère le lien Stripe Dashboard adaptatif test/prod
  function stripeChargeLink(chargeId) {
    if (!chargeId) return '<span class="text-muted">—</span>';
    return '<a href="' + stripeDashboardBase + chargeId + '" target="_blank" title="Voir sur Stripe Dashboard"><code>' + chargeId.substring(0, 16) + '...</code> <i class="fa fa-external-link"></i></a>';
  }
  
  // Génère le nom cliquable vers le profil
  function profileLink(userId, name) {
    if (!userId) return name;
    return '<a href="/neighbors/' + userId + '" target="_blank" title="Voir le profil">' + name + '</a>';
  }
  
  // Génère le badge de statut
  function statusBadge(status) {
    if (status === 'transferred') return '<span class="badge badge-success"><i class="fa fa-check mr-1"></i>Transféré</span>';
    if (status === 'refunded') return '<span class="badge badge-warning"><i class="fa fa-undo mr-1"></i>Remboursé</span>';
    return '<span class="badge badge-primary"><i class="fa fa-clock-o mr-1"></i>En attente</span>';
  }

  function payoutValue(value) {
    if (value === null || value === undefined || value === '') return '—';
    return value;
  }

  function resetPayoutEditUnlockStatus() {
    $('#payoutEditUnlockStatus').removeClass('text-success text-danger').addClass('text-muted').text('');
  }

  function authorizePayoutProfileEdit() {
    if (!payoutProfileUnlockUrl) {
      return;
    }

    var btn = $('#payoutAuthorizeEditBtn');
    var csrfToken = $('meta[name="csrf-token"]').attr('content');

    btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin mr-1"></i>Autorisation...');
    resetPayoutEditUnlockStatus();

    $.ajax({
      url: payoutProfileUnlockUrl,
      method: 'POST',
      headers: { 'X-CSRF-Token': csrfToken }
    })
      .done(function(response) {
        var message = (response && response.message) ? response.message : 'Autorisation enregistree.';
        $('#payoutEditUnlockStatus').removeClass('text-muted text-danger').addClass('text-success').text(message);
      })
      .fail(function(xhr) {
        var message = 'Impossible d autoriser la reedition.';
        if (xhr && xhr.responseJSON && xhr.responseJSON.error) {
          message = xhr.responseJSON.error;
        }
        $('#payoutEditUnlockStatus').removeClass('text-muted text-success').addClass('text-danger').text(message);
      })
      .always(function() {
        btn.prop('disabled', false).html('<i class="fa fa-unlock mr-1"></i>Autoriser la reedition');
      });
  }

  function updatePayoutProfileStatus(profileComplete, missingCount) {
    var el = $('#payoutProfileStatus');
    if (profileComplete) {
      el.removeClass('alert-info alert-warning alert-danger').addClass('alert-success');
      el.html('<i class="fa fa-check-circle mr-2"></i>Profil local complet. Pret pour demande de retrait.');
    } else if (missingCount > 0) {
      el.removeClass('alert-info alert-success alert-danger').addClass('alert-warning');
      el.html('<i class="fa fa-exclamation-triangle mr-2"></i>Profil incomplet: ' + missingCount + ' element(s) manquant(s).');
    } else {
      el.removeClass('alert-warning alert-success alert-danger').addClass('alert-info');
      el.html('<i class="fa fa-info-circle mr-2"></i>Profil partiellement renseigne.');
    }
  }

  function openPayoutProfileModal(projectName, profileUrl, unlockUrl, editUrl) {
    payoutProfileUnlockUrl = unlockUrl || null;
    payoutProfileEditUrl = editUrl || '#';

    $('#payoutOwnerEditFormLink').attr('href', payoutProfileEditUrl);
    $('#payoutAuthorizeEditBtn').prop('disabled', !payoutProfileUnlockUrl);
    resetPayoutEditUnlockStatus();

    $('#payoutProfileProjectName').text(projectName);
    $('#payoutProfileStatus').removeClass('alert-success alert-warning alert-danger').addClass('alert-info').html('<i class="fa fa-spinner fa-spin mr-2"></i>Chargement...');

    $('#payoutOwnerName, #payoutOwnerEmail, #payoutOwnerType, #payoutOwnerOrganization, #payoutOwnerBirthday, #payoutOwnerNationality, #payoutOwnerResidence, #payoutOwnerPhone, #payoutOwnerStripeAccount').text('—');
    $('#payoutBankAddress, #payoutBankCity, #payoutBankRegion, #payoutBankPostal, #payoutBankCountry, #payoutBankReferenceType, #payoutBankReferenceValue').text('—');
    $('#payoutKycList').html('<li class="list-group-item text-muted">Chargement...</li>');
    $('#payoutMissingList').html('<li class="list-group-item text-muted">Chargement...</li>');
    $('#payoutStripeStatus').removeClass('alert-success alert-warning alert-danger').addClass('alert-light').html('Chargement...');
    $('#payoutStripeRequirements').html('<li class="list-group-item text-muted">Chargement...</li>');

    $('#payoutProfileModal').modal('show');

    $.getJSON(profileUrl)
      .done(function(data) {
        var owner = data.owner || {};
        var bank = data.bank || {};
        var stripe = data.stripe || {};
        var missingFields = data.missing_fields || [];
        var kycDocs = data.kyc_documents || [];

        updatePayoutProfileStatus(!!data.profile_complete, missingFields.length);

        $('#payoutOwnerName').text(payoutValue(owner.name));
        $('#payoutOwnerEmail').text(payoutValue(owner.email));
        $('#payoutOwnerType').text(payoutValue(owner.profile_type));
        $('#payoutOwnerOrganization').text(payoutValue(owner.organization_name));
        $('#payoutOwnerBirthday').text(payoutValue(owner.birthday));
        $('#payoutOwnerNationality').text(payoutValue(owner.nationality));
        $('#payoutOwnerResidence').text(payoutValue(owner.residence_country));
        $('#payoutOwnerPhone').text(payoutValue(owner.mobile_phone));
        $('#payoutOwnerStripeAccount').text(payoutValue(owner.stripe_connect_account_id));

        $('#payoutBankAddress').text(payoutValue(bank.owner_address));
        $('#payoutBankCity').text(payoutValue(bank.owner_city));
        $('#payoutBankRegion').text(payoutValue(bank.owner_region));
        $('#payoutBankPostal').text(payoutValue(bank.owner_postal_code));
        $('#payoutBankCountry').text(payoutValue(bank.other_country));
        $('#payoutBankReferenceType').text(payoutValue(bank.bank_reference_type));
        $('#payoutBankReferenceValue').text(payoutValue(bank.bank_reference_value));
        updatePayoutStripeStatus(stripe);

        var kycList = $('#payoutKycList');
        kycList.empty();
        if (kycDocs.length === 0) {
          kycList.html('<li class="list-group-item text-muted">Aucun justificatif configure.</li>');
        } else {
          kycDocs.forEach(function(doc) {
            var status = doc.uploaded ? '<span class="badge badge-success">Recu</span>' : '<span class="badge badge-danger">Manquant</span>';
            var uploadedAt = doc.uploaded_at ? '<small class="text-muted ml-2">(' + doc.uploaded_at + ')</small>' : '';
            var documents = doc.documents || [];
            var filesHtml = '';

            if (documents.length > 0) {
              filesHtml += '<div class="mt-2 d-flex flex-wrap">';
              documents.forEach(function(file) {
                if (!file || !file.url) return;
                var safeUrl = escapeHtml(file.url);
                var safeName = escapeHtml(file.filename || 'Document');

                if (file.pdf) {
                  filesHtml += '<a class="btn btn-sm btn-outline-primary mr-2 mb-2" href="' + safeUrl + '" target="_blank" rel="noopener"><i class="fa fa-file-pdf-o mr-1"></i>' + safeName + '</a>';
                } else if (file.image) {
                  filesHtml += '<img src="' + safeUrl + '" data-full-url="' + safeUrl + '" alt="' + safeName + '" title="Cliquer pour agrandir" onclick="openPayoutDocViewer(this.dataset.fullUrl || this.src); return false;" class="payout-doc-thumb mr-2 mb-2" style="height:64px;width:auto;cursor:zoom-in;border:1px solid #dee2e6;border-radius:4px;padding:2px;background:#fff;" />';
                } else {
                  filesHtml += '<a class="btn btn-sm btn-outline-secondary mr-2 mb-2" href="' + safeUrl + '" target="_blank" rel="noopener">' + safeName + '</a>';
                }
              });
              filesHtml += '</div>';
            }

            var countBadge = documents.length > 0 ? '<span class="badge badge-light ml-2">' + documents.length + ' fichier(s)</span>' : '';
            kycList.append('<li class="list-group-item"><div class="d-flex justify-content-between align-items-center"><div><strong>' + escapeHtml(payoutValue(doc.label)) + '</strong>' + uploadedAt + countBadge + '</div>' + status + '</div>' + filesHtml + '</li>');
          });
        }

        var missingList = $('#payoutMissingList');
        missingList.empty();
        if (missingFields.length === 0) {
          missingList.html('<li class="list-group-item text-success">Aucun champ manquant.</li>');
        } else {
          missingFields.forEach(function(item) {
            missingList.append('<li class="list-group-item text-warning"><i class="fa fa-exclamation-circle mr-2"></i>' + item + '</li>');
          });
        }
      })
      .fail(function(xhr) {
        var message = 'Impossible de charger le profil de retrait.';
        if (xhr && xhr.responseJSON && xhr.responseJSON.error) {
          message = xhr.responseJSON.error;
        }
        $('#payoutProfileStatus').removeClass('alert-info alert-success alert-warning').addClass('alert-danger').html('<i class="fa fa-times-circle mr-2"></i>' + message);
        $('#payoutKycList').html('<li class="list-group-item text-muted">—</li>');
        $('#payoutMissingList').html('<li class="list-group-item text-muted">—</li>');
        $('#payoutStripeStatus').removeClass('alert-light alert-success alert-warning').addClass('alert-danger').html('Impossible de charger le statut Stripe.');
        $('#payoutStripeRequirements').html('<li class="list-group-item text-muted">—</li>');
      });
  }

  function updatePayoutStripeStatus(stripe) {
    var status = $('#payoutStripeStatus');
    var list = $('#payoutStripeRequirements');
    var account = stripe.account_id || 'Aucun compte';
    var transfers = stripe.transfers || 'inconnu';
    var payoutsEnabled = stripe.payouts_enabled === true;
    var requirements = []
      .concat(stripe.currently_due || [])
      .concat(stripe.past_due || [])
      .concat(stripe.future_currently_due || [])
      .concat(stripe.future_past_due || []);
    var errors = stripe.errors || [];

    status.removeClass('alert-light alert-success alert-warning alert-danger');
    if (stripe.error) {
      status.addClass('alert-danger').html('<strong>Erreur Stripe:</strong> ' + escapeHtml(stripe.error));
    } else if (payoutsEnabled && transfers === 'active' && requirements.length === 0 && errors.length === 0) {
      status.addClass('alert-success').html('<strong>Stripe OK.</strong> Compte ' + escapeHtml(account) + ' pret pour les virements.');
    } else {
      status.addClass('alert-warning').html('<strong>Stripe demande encore une verification.</strong> Compte ' + escapeHtml(account) + ', transfers=' + escapeHtml(transfers) + ', payouts_enabled=' + payoutsEnabled);
    }

    list.empty();
    if (requirements.length === 0 && errors.length === 0 && !stripe.disabled_reason) {
      list.html('<li class="list-group-item text-success">Aucune exigence Stripe bloquante retournee.</li>');
      return;
    }
    if (stripe.disabled_reason) {
      list.append('<li class="list-group-item text-danger"><strong>disabled_reason:</strong> ' + escapeHtml(stripe.disabled_reason) + '</li>');
    }
    requirements.forEach(function(item) {
      list.append('<li class="list-group-item text-warning">' + escapeHtml(item) + '</li>');
    });
    errors.forEach(function(err) {
      var text = [err.requirement, err.code, err.reason].filter(Boolean).join(' - ');
      list.append('<li class="list-group-item text-danger">' + escapeHtml(text || 'Erreur Stripe sans detail') + '</li>');
    });
  }
  
  // Calcule et formate le taux Stripe estimé
  function stripeRateDisplay(amount) {
    var pct = '2.9%';
    var fix = '0.25€';
    return '<small class="text-muted">' + pct + ' + ' + fix + '</small>';
  }
  
  // Filtre les lignes traitées/non-traitées dans le modal transfert
  function filterTransferRows() {
    var showTreated = document.getElementById('toggleTreatedTransfer').checked;
    $('#transferContributionsList tr').each(function() {
      var status = $(this).attr('data-status');
      if (status && status !== 'pending') {
        if (showTreated) {
          $(this).show().css('opacity', '0.6').addClass('text-muted');
        } else {
          $(this).hide();
        }
      }
    });
  }
  
  // Filtre les lignes traitées/non-traitées dans le modal remboursement
  function filterRefundRows() {
    var showTreated = document.getElementById('toggleTreatedRefund').checked;
    $('#refundContributorsList tr').each(function() {
      var status = $(this).attr('data-status');
      if (status && status !== 'pending') {
