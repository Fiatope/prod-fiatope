- content_for :title, t('.title')
.admin
  .row
    = render 'neighborly/admin/layouts/menu'
    section.content.large-12.columns
      .filters
        = form_tag contributions_path, method: :get, class: 'form-horizontal' do |f|
          .row
            .large-3.columns
              = label_tag :by_user_id, t('.user_id')
              = text_field_tag :by_user_id, params[:by_user_id], class: 'input-small'
            .large-3.columns
              = label_tag :between_values, t('.between_values')
              = text_field_tag 'between_values[start_at]', (params[:between_values][:start_at] if params[:between_values].present?), class: 'input-small'
              | &nbsp;
              | &nbsp;
              = text_field_tag 'between_values[ends_at]', (params[:between_values][:ends_at] if params[:between_values].present?), class: 'input-small'
            .large-3.columns
              = label_tag :with_state, t('.by_state')
              = select_tag :with_state, options_for_select(Contribution.state_names, params[:with_state]), include_blank: true
            .large-3.columns
              = label_tag :by_key, t('.key')
              = text_field_tag :by_key, params[:by_key]
            .large-6.columns
              = label_tag :project_name_contains, t('.project')
              = text_field_tag :project_name_contains, params[:project_name_contains]
            .large-6.columns
              = label_tag :user_name_contains, t('.user')
              = text_field_tag :user_name_contains, params[:user_name_contains], class: 'input-medium'
            .large-6.columns
              = label_tag :user_email_contains, t('.user_email')
              = text_field_tag :user_email_contains, params[:user_email_contains], class: 'input-medium'
            .large-6.columns.text-left
              = check_box_tag :credits, :true, params[:credits]
              = label_tag :credits, t('.credits')
            .large-3.columns
              = label_tag :period, t('.period_filter')
              = select_tag :period, options_for_select([[t('.period_all'), ''], [t('.period_custom'), 'custom'], [t('.period_day'), 'day'], [t('.period_week'), 'week'], [t('.period_month'), 'month'], [t('.period_year'), 'year']], params[:period])
            .large-3.columns
              = label_tag :period_reference, t('.period_reference')
              = date_field_tag :period_reference, params[:period_reference], class: 'input-small'
            .large-6.columns.text-right
              = submit_tag t('.submit'), class: 'button'

      - if @period_summary.present?
        .panel.callout.radius[style='margin-bottom: 15px;']
          h5 = t('.period_summary_title')
          p
            strong = t('.period_summary_count')
            | :
            |  #{@period_summary[:contributions_count]}
          p
            strong = t('.period_summary_total_collected')
            | :
            |  #{number_to_currency(@period_summary[:total_collected])}
          - if @period_summary[:start_at].present? || @period_summary[:end_at].present?
            p
              strong = t('.period_summary_range')
              | :
              |  #{l(@period_summary[:start_at], format: :short) if @period_summary[:start_at].present?}
              |  -
              |  #{l(@period_summary[:end_at], format: :short) if @period_summary[:end_at].present?}
          p.small = t('.period_table_hint')

      .row
        .large-6.columns.text-left
          = paginate @contributions
        .large-6.columns.text-right
          = pluralize_without_number collection.count, t('words.found_singular'), t('words.found_plural')
          | &nbsp;
          strong= collection.count
          | &nbsp;
          = pluralize_without_number(collection.count, t('words.contribution_singular'), t('words.contribution_plural')).downcase
      - if @contributions.empty?
        = t('.no_contributions')
      - else
        h5 = t('.filtered_contributions_title')
        .table-wrapper style="overflow-x: auto; -webkit-overflow-scrolling: touch;"
          table
            thead
              tr
                th= t('.info')
                th= t('.project')
                th= t('.user')
                th= t('.value')
                th= t('.payment_method')
                th= t('.reward')
                th= t('.key')
                th= t('.anonymous')
                th= t('.credits')
                th= t('.id')
                th= t('.mailing')
                th= t('.state')
                th Actions
                th
            tbody
              - @contributions.includes(:project, :user, :reward).each do |contribution|
                tr id=contribution.id
                td
                  .modal.fade id="contribution-info-#{contribution.id}"
                    .modal-dialog
                      .modal-content
                        .modal-header
                          button[class="close" data-dismiss="modal" aria-hidden="true"] ×
                          h5.modal-title = t('.contribution_info', key: contribution.key)
                        .modal-body
                          p
                            strong= t('.payment_method')
                            | &nbsp;
                            = contribution.payment_method
                          p
                            strong= t('.payment_fee')
                            | &nbsp;
                            = number_to_currency contribution.payment_service_fee
                          p
                            strong= t('.fee_paid_by_user')
                            | &nbsp;
                            = contribution.payment_service_fee_paid_by_user ? t('words._yes') : t('words._no')
                          p
                            strong= t('.payment_id')
                            | &nbsp;
                            = contribution.payment_id
                          p
                            strong= t('.user_email')
                            | &nbsp;
                            = contribution.user.email
                          p
                            strong= t('.created_at')
                            | &nbsp;
                            = l(contribution.created_at)

                  = link_to "javascript:void(0)", class: 'button tiny secondary contribution-info', data: { 'reveal-id' => "contribution-info-#{contribution.id}" } do
                    i.icon-et-info-circled
                td title=contribution.project.name
                  = link_to main_app.project_path(contribution.project) do
                    = image_tag contribution.project.display_image, size: '100x100'
                td title=contribution.user.display_name
                  = link_to main_app.user_path(contribution.user) do
                    = contribution.user.display_image_html width: 50, height: 50
                  .user_id= best_in_place contribution, :user_id, type: :input
                td= best_in_place contribution, :value, type: :input
                td= contribution.payment_method || '-'
                td title=("#{contribution.reward.display_minimum} - #{contribution.reward.description}" if contribution.reward )
                  - if contribution.reward
                      = "#{contribution.reward.display_minimum}  "
                  - elsif contribution.rewards
                    - for reward in contribution.rewards
                      = "#{reward.display_minimum}  "
                      - contribution.contribution_rewards.each do |rc| 
                        = "  #{rc.reward_id == reward.id && rc.quantity ? rc.quantity.to_i : '' }"
                  - else
                    | -
                  | &nbsp;
                  .dropdown
                    = link_to 'javascript:void(0);', class: 'button tiny secondary dropdown-toggle', data: {dropdown: "dropdown-reward-#{contribution.id}", toggle: "dropdown"} do
                      i.icon-et-down-dir
                    ul[id="dropdown-reward-#{contribution.id}" data-dropdown-content class="dropdown-menu"]
                      li title=("#{t('.no_reward')}" ) = link_to t('.no_reward'), change_reward_contribution_path(contribution, reward_id: nil), method: :put
                      - contribution.available_rewards.each do |reward|
                        li title=("#{reward.display_minimum} - #{reward.description}" ) = link_to reward.minimum_value, change_reward_contribution_path(contribution, reward_id: reward.id, local_params: params.to_unsafe_h), method: :put

                td.key= contribution.key
                td.checkbox= best_in_place contribution, :anonymous, type: :checkbox, collection: [t('words._no'), t('words._yes')]
                td= (contribution.credits ? t('words._yes') : t('words._no'))
                td= best_in_place contribution,:id, type: :input
                td= link_to t('.send_mail'), main_app.mailing_project_contribution_path(contribution.project, contribution)
                td= contribution.state
                  .dropdown
                    = link_to 'javascript:void(0);', class: 'button tiny secondary dropdown-toggle', data: {dropdown: "dropdown-#{contribution.id}", toggle: "dropdown"} do
                      i.icon-et-down-dir
                    ul[id="dropdown-#{contribution.id}" data-dropdown-content class="dropdown-menu"]
                      - if contribution.confirmed?
                        li= link_to t('admin.contributions.index.unconfirm_contribution'), pendent_contribution_path(contribution, local_params: params.to_unsafe_h), method: :put
                      - else
                        li= link_to t('admin.contributions.index.confirm_contribution'), confirm_contribution_path(contribution, local_params: params.to_unsafe_h), method: :put
                      - if contribution.requested_refund? or contribution.confirmed?
                        li= link_to t('admin.contributions.index.refund_contribution'), refund_contribution_path(contribution, local_params: params.to_unsafe_h), method: :put
                      li= link_to t('admin.contributions.index.refund_and_hide'), hide_contribution_path(contribution, local_params: params.to_unsafe_h), method: :put
                      li= link_to t('admin.contributions.index.cancel'), cancel_contribution_path(contribution, local_params: params.to_unsafe_h), method: :put
                      li= link_to t('admin.contributions.index.push_to_trash'), push_to_trash_contribution_path(contribution, local_params: params.to_unsafe_h), method: :put
                td
                  - if contribution.pending? or contribution.canceled?
                    a.manual-confirm-btn.button.tiny.success[href="javascript:void(0);" data-contribution-id="#{contribution.id}" data-csrf="#{form_authenticity_token}"] ✓ Valider
      /= paginate @contributions

javascript:
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.manual-confirm-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var contributionId = this.getAttribute('data-contribution-id');
        var csrf = this.getAttribute('data-csrf');
        var txId = prompt('ID Transaction (vérifiez dans PayPlus/Orange Money):');
        if (txId && txId.trim() !== '') {
          if (confirm('Confirmer la validation manuelle de cette contribution ?')) {
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '/admin/contributions/' + contributionId + '/manual_confirm';
            var methodInput = document.createElement('input');
            methodInput.type = 'hidden';
            methodInput.name = '_method';
            methodInput.value = 'put';
            form.appendChild(methodInput);
            var csrfInput = document.createElement('input');
            csrfInput.type = 'hidden';
            csrfInput.name = 'authenticity_token';
            csrfInput.value = csrf;
            form.appendChild(csrfInput);
            var txInput = document.createElement('input');
            txInput.type = 'hidden';
            txInput.name = 'transaction_id';
            txInput.value = txId.trim();
            form.appendChild(txInput);
            document.body.appendChild(form);
            form.submit();
          }
        }
      });
    });
  });
