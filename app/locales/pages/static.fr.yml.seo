fr:
   static:
    successful: 
      title: 'Guide des projets'
      meta_description: 'Découvrez comment créer un projet et comment en faire une réussite. Fiatope vous livre toutes les astuces.'
    why_fiatope: 
      title: "Pourquoi nous choisir ?"
      meta_description: "N’hésitez plus et proposez votre projet à toute notre communauté: sécurité, fiabilité, professionnalisme et transparence."
    about:
      title: 'A propos'
      meta_description: "Découvrez l’équipe Fiatope et tous leurs projets, ce sur quoi nous travaillons et ce en quoi nous croyons."
    org_partners_oser: 
      title: "Oser l'Afrique" 
      meta_description: "Oser l'Afrique se met au côté de Fiatope pour developper les projets innovants d'Afrique grâce aux levées de fond."
    org_partners:
      title: "Devenez partenaire de Fiatope"
      meta_description: "Fiatope aide des associations locales et entrepreneuriales à se développer grâce au soutien de milliers d'âmes de bonne volonté dans le monde."
    csr_partners:
      title: "Partenaires RSE" 
      meta_description: "Rejoignez l'ensemble des structures qui accompagnent Fiatope dans l'investissement participatif et contribuez aux projets innovants de l'Afrique"
    faq:
      title: "Questions fréquentes sur Fiatope"
      meta_description: 'Vous avez des questions sur le fonctionnement de Fiatope ? Découvrez toutes les réponses ou contactez-nous directement.'
    privacy:
      title: "Politique de confidentialité"
      meta_description: "Fiatope met tout en oeuvre pour sécuriser vos données et vous donnez une expérience utilisateur parfaite."
    price:
      title: "Tarifs"
      meta_description: "Vous souhaitez créer un projet pour le rayonnement de l’Afrique ? Découvrez tout ce qu’il faut savoir pour la création de votre compte."
